export component ClockTile inherits Rectangle {
    in property <string> label;
    in property <string> month;
    in property <string> day;
    in property <string> hour;
    in property <string> minute;
    in property <string> second;
    in property <color> accent: #ffffff;
    in property <bool> main-zone: false;
    in property <bool> show-seconds: true;
    in property <float> clock-scale: 1.0;
    in property <bool> soft-style: false;

    width: 99px * root.clock-scale;
    height: 60px * root.clock-scale;
    background: root.soft-style ? accent : @linear-gradient(180deg, #383838 45.3%, accent 77.6%);
    clip: true;

    Text {
        x: 4px * root.clock-scale;
        y: 5px * root.clock-scale;
        width: 48px * root.clock-scale;
        height: 20px * root.clock-scale;
        text: root.label;
        font-family: "Carlito";
        font-size: (root.soft-style ? 12px : 16px) * root.clock-scale;
        font-weight: root.main-zone ? 600 : 400;
        color: root.soft-style ? #111111 : root.main-zone ? #ffffff : #b9b9b9;
        horizontal-alignment: left;
        vertical-alignment: top;
        overflow: elide;
    }

    Text {
        x: 51px * root.clock-scale;
        y: 5px * root.clock-scale;
        width: 28px * root.clock-scale;
        height: 20px * root.clock-scale;
        text: root.month;
        font-family: "Carlito";
        font-size: (root.soft-style ? 12px : 16px) * root.clock-scale;
        font-weight: 600;
        color: root.soft-style ? #222222 : #b9b9b9;
        horizontal-alignment: right;
        vertical-alignment: top;
    }

    Text {
        x: 79px * root.clock-scale;
        y: 5px * root.clock-scale;
        width: 18px * root.clock-scale;
        height: 20px * root.clock-scale;
        text: root.day;
        font-family: "Carlito";
        font-size: (root.soft-style ? 12px : 16px) * root.clock-scale;
        font-weight: 600;
        color: root.soft-style ? #222222 : #b9b9b9;
        horizontal-alignment: left;
        vertical-alignment: top;
    }

    Text {
        x: (root.show-seconds ? 0px : 14px) * root.clock-scale;
        y: 37px * root.clock-scale;
        width: 28px * root.clock-scale;
        height: 25px * root.clock-scale;
        text: root.hour;
        font-family: "Carlito";
        font-size: 25px * root.clock-scale;
        font-weight: 600;
        color: #000000;
        horizontal-alignment: right;
        vertical-alignment: bottom;
    }

    Text {
        x: (root.show-seconds ? 30px : 44px) * root.clock-scale;
        y: 33px * root.clock-scale;
        width: 9px * root.clock-scale;
        height: 25px * root.clock-scale;
        text: ":";
        font-family: "Carlito";
        font-size: 16px * root.clock-scale;
        font-weight: 600;
        color: #000000;
        horizontal-alignment: center;
        vertical-alignment: bottom;
    }

    Text {
        x: (root.show-seconds ? 34px : 48px) * root.clock-scale;
        y: 37px * root.clock-scale;
        width: 38px * root.clock-scale;
        height: 25px * root.clock-scale;
        text: root.minute;
        font-family: "Carlito";
        font-size: 25px * root.clock-scale;
        color: #000000;
        horizontal-alignment: center;
        vertical-alignment: bottom;
    }

    Text {
        x: 67px * root.clock-scale;
        y: 33px * root.clock-scale;
        width: 9px * root.clock-scale;
        height: 25px * root.clock-scale;
        text: ":";
        font-family: "Carlito";
        font-size: 16px * root.clock-scale;
        font-weight: 600;
        color: #000000;
        horizontal-alignment: center;
        vertical-alignment: bottom;
        visible: root.show-seconds;
    }

    Text {
        x: 67px * root.clock-scale;
        y: 34px * root.clock-scale;
        width: 38px * root.clock-scale;
        height: 25px * root.clock-scale;
        text: root.second;
        font-family: "Carlito";
        font-size: 16px * root.clock-scale;
        color: #000000;
        horizontal-alignment: center;
        vertical-alignment: bottom;
        visible: root.show-seconds;
    }
}
