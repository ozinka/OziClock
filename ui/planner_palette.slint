import { Palette } from "std-widgets.slint";

export global PlannerPalette {
    public function apply-theme() {
        Palette.color-scheme = light ? ColorScheme.light : ColorScheme.dark;
    }
    in-out property <bool> light: false;
    out property <color> surface: light ? #f3f6f5 : #1a1c21;
    out property <color> sidebar: light ? #e6ecea : #1a1c21;
    out property <color> card: light ? #ffffff : #202226;
    out property <color> inset: light ? #eaf0ee : #1f2227;
    out property <color> border: light ? #bdcbc6 : #3a3e46;
    out property <color> text: light ? #253b34 : #f1f3f5;
    out property <color> heading: light ? #162e25 : #f1f3f5;
    out property <color> muted: light ? #536d62 : #7d838e;
    out property <color> secondary: light ? #435f53 : #aeb4bd;
    out property <color> disabled: light ? #65776f : #747b86;
    out property <color> selected: light ? #d5e5de : #30343c;
    out property <color> positive: light ? #dcefe5 : #263a36;
    out property <color> negative: light ? #f4dfe1 : #3b2b2e;
    in-out property <color> accent: #77d7cb;
    in-out property <color> accent-foreground: #082725;
    in-out property <color> event-color: #b99655;
    in-out property <color> event-color-foreground: #082725;
    in-out property <color> reminder-color: #77d7cb;
    in-out property <color> reminder-color-foreground: #082725;
    in-out property <color> task-color: #547d78;
    in-out property <color> task-color-foreground: #082725;
}
