import { Palette } from "std-widgets.slint";

export global PlannerPalette {
    public function apply-theme() {
        Palette.color-scheme = light ? ColorScheme.light : ColorScheme.dark;
    }
    in-out property <bool> light: false;
    out property <color> surface: light ? #f3f6f5 : #171d1f;
    out property <color> sidebar: light ? #e6ecea : #13191b;
    out property <color> card: light ? #ffffff : #20292b;
    out property <color> inset: light ? #eaf0ee : #1b2325;
    out property <color> border: light ? #bdcbc6 : #344144;
    out property <color> text: light ? #253b34 : #dce8e5;
    out property <color> heading: light ? #162e25 : #e1eae8;
    out property <color> muted: light ? #536d62 : #829492;
    out property <color> secondary: light ? #435f53 : #aab9b7;
    out property <color> disabled: light ? #65776f : #718280;
    out property <color> selected: light ? #d5e5de : #314043;
    out property <color> positive: light ? #dcefe5 : #223b37;
    out property <color> negative: light ? #f4dfe1 : #3a292b;
    in-out property <color> accent: #77d7cb;
    in-out property <color> accent-foreground: #082725;
    in-out property <color> event-color: #b99655;
    in-out property <color> event-color-foreground: #082725;
    in-out property <color> reminder-color: #77d7cb;
    in-out property <color> reminder-color-foreground: #082725;
    in-out property <color> task-color: #547d78;
    in-out property <color> task-color-foreground: #082725;
}
