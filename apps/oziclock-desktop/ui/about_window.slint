import { AppPalette } from "../../../ui/app_palette.slint";
export component AboutWindow inherits Window {
    title: "About OziClock";
    no-frame: true;
    always-on-top: true;
    preferred-width: 430px;
    preferred-height: 280px;
    min-width: 430px;
    min-height: 280px;
    max-width: 430px;
    max-height: 280px;
    background: transparent;
    in property <string> version;
    in property <float> corner-radius: 12;
    callback request-close();
    callback request-open-project-url();

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: AppPalette.surface;
        border-radius: root.corner-radius * 1px;
        clip: true;
        border-width: 1px;
        border-color: AppPalette.border;

        Rectangle { x: 28px; y: 28px; width: 50px; height: 50px; border-radius: 13px; background: @linear-gradient(180deg, #383838 45%, #8bd8e3 100%); }
        Text { x: 96px; y: 30px; text: "OZI CLOCK"; color: AppPalette.heading; font-family: "Carlito"; font-size: 21px; font-weight: 700; }
        Text { x: 96px; y: 58px; text: "A world clock for your desktop"; color: AppPalette.muted; font-family: "Carlito"; font-size: 13px; }
        Rectangle { x: 28px; y: 104px; width: 374px; height: 1px; background: AppPalette.border; }
        Text { x: 28px; y: 129px; text: "Version " + root.version; color: AppPalette.text; font-family: "Carlito"; font-size: 14px; }
        Text { x: 28px; y: 158px; width: 355px; text: "A lightweight cross-platform clock with multiple time zones."; color: AppPalette.muted; font-family: "Carlito"; font-size: 13px; wrap: word-wrap; }
        Text { x: 28px; y: 211px; text: "GitHub: ozinka/OziClock"; color: AppPalette.link; font-family: "Carlito"; font-size: 13px; }
        TouchArea { x: 28px; y: 207px; width: 180px; height: 24px; clicked => { root.request-open-project-url(); } }
        Text { x: 28px; y: 239px; text: "© OziClock"; color: AppPalette.muted; font-family: "Carlito"; font-size: 12px; }
        Rectangle { x: 322px; y: 220px; width: 80px; height: 36px; border-radius: 5px; background: AppPalette.primary; Text { width: parent.width; height: parent.height; text: "OK"; color: white; font-family: "Carlito"; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; TouchArea { clicked => { root.request-close(); } } } }
        Text {
            x: 370px; y: 18px; width: 36px; height: 36px; text: "×"; color: AppPalette.secondary; font-family: "Carlito"; font-size: 25px; horizontal-alignment: center; vertical-alignment: center;
            TouchArea { clicked => { root.request-close(); } }
        }
    }
}
