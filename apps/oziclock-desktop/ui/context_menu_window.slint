export component ContextMenuWindow inherits Window {
    title: "OziClock menu";
    no-frame: true;
    always-on-top: true;
    preferred-width: 216px;
    preferred-height: 180px;
    min-width: 216px;
    min-height: 180px;
    max-width: 216px;
    max-height: 180px;
    background: transparent;

    callback request-open-settings();
    callback request-open-calendar();
    callback request-open-about();
    callback request-exit();

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 7px;
        border-width: 1px;
        border-color: #3b3e46;
        background: #24262c;

        Text {
            x: 15px; y: 10px; width: 186px; height: 34px;
            text: "Calendar…";
            color: #f0f1f3;
            font-family: "Carlito";
            font-size: 14px;
            vertical-alignment: center;
            TouchArea { clicked => { root.request-open-calendar(); } }
        }
        Text {
            x: 15px; y: 45px; width: 186px; height: 34px;
            text: "Clock Settings…";
            color: #f0f1f3;
            font-family: "Carlito";
            font-size: 14px;
            vertical-alignment: center;
            TouchArea { clicked => { root.request-open-settings(); } }
        }
        Text {
            x: 15px; y: 80px; width: 186px; height: 34px;
            text: "About OziClock";
            color: #d4d7dd;
            font-family: "Carlito";
            font-size: 14px;
            vertical-alignment: center;
            TouchArea { clicked => { root.request-open-about(); } }
        }
        Rectangle { x: 12px; y: 123px; width: 192px; height: 1px; background: #3b3e46; }
        Text {
            x: 15px; y: 131px; width: 186px; height: 34px;
            text: "Exit";
            color: #f09090;
            font-family: "Carlito";
            font-size: 14px;
            vertical-alignment: center;
            TouchArea { clicked => { root.request-exit(); } }
        }
    }
}
