import { AppPalette } from "../../../ui/app_palette.slint";
export component ContextMenuWindow inherits Window {
    title: "OziClock menu";
    no-frame: true;
    always-on-top: true;
    preferred-width: 216px;
    preferred-height: 215px;
    min-width: 216px;
    min-height: 215px;
    max-width: 216px;
    max-height: 215px;
    background: transparent;

    callback request-open-settings();
    callback request-open-planner();
    callback request-toggle-rulers();
    callback request-open-about();
    callback request-exit();
    in property <bool> show-rulers: false;

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 7px;
        border-width: 1px;
        border-color: AppPalette.border;
        background: AppPalette.surface;

        Text {
            x: 15px; y: 10px; width: 186px; height: 34px;
            text: "Open Planner";
            color: AppPalette.text;
            font-family: "Carlito";
            font-size: 14px;
            vertical-alignment: center;
            TouchArea { clicked => { root.request-open-planner(); } }
        }
        Text {
            x: 15px; y: 45px; width: 186px; height: 34px;
            text: "Settings…";
            color: AppPalette.text;
            font-family: "Carlito";
            font-size: 14px;
            vertical-alignment: center;
            TouchArea { clicked => { root.request-open-settings(); } }
        }
        Text {
            x: 15px; y: 80px; width: 186px; height: 34px;
            text: root.show-rulers ? "Hide rulers" : "Show rulers";
            color: AppPalette.text;
            font-family: "Carlito";
            font-size: 14px;
            vertical-alignment: center;
            TouchArea { clicked => { root.request-toggle-rulers(); } }
        }
        Text {
            x: 15px; y: 115px; width: 186px; height: 34px;
            text: "About OziClock";
            color: AppPalette.secondary;
            font-family: "Carlito";
            font-size: 14px;
            vertical-alignment: center;
            TouchArea { clicked => { root.request-open-about(); } }
        }
        Rectangle { x: 12px; y: 158px; width: 192px; height: 1px; background: AppPalette.border; }
        Text {
            x: 15px; y: 166px; width: 186px; height: 34px;
            text: "Exit";
            color: AppPalette.danger;
            font-family: "Carlito";
            font-size: 14px;
            vertical-alignment: center;
            TouchArea { clicked => { root.request-exit(); } }
        }
    }
}
