export struct CalendarDayData {
    text: string,
    date-id: string,
    weekend: bool,
    muted: bool,
    selected: bool,
    today: bool,
}

export struct CalendarMonthData {
    name: string,
    current: bool,
    days: [CalendarDayData],
}

component CalendarButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked();
    border-radius: 6px;
    border-width: 1px;
    border-color: root.active ? #16877f : #70aaa6;
    background: root.active ? #16877f : #d9f7f5;
    Text { text: root.text; color: root.active ? white : #183b38; font-family: "Carlito"; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
    TouchArea { clicked => { root.clicked(); } }
}

export component CalendarWindow inherits Window {
    title: "OziClock — Calendar";
    no-frame: true;
    always-on-top: true;
    preferred-width: 650px;
    preferred-height: root.view == 1 ? 650px : (root.view == 2 ? 590px : 500px);
    min-width: 650px;
    max-width: 650px;
    min-height: root.preferred-height;
    max-height: root.preferred-height;
    background: transparent;

    in-out property <int> view: 0;
    in property <string> heading;
    in property <string> selected-label;
    in property <[string]> weekday-labels;
    in property <[CalendarDayData]> days;
    in property <[CalendarDayData]> week-days;
    in property <[CalendarMonthData]> months;
    in property <[string]> hour-labels;
    in property <color> accent: #9ee9e4;
    in property <float> corner-radius: 12;
    in property <bool> light-theme: true;
    in property <float> current-time-y: -1;
    in property <string> current-time-label;
    in-out property <length> week-scroll-y: 0px;

    callback request-close();
    callback request-window-drag();
    callback request-view(int);
    callback request-previous();
    callback request-today();
    callback request-next();
    callback request-select-date(string);
    callback request-select-month(int);
    callback request-week-scroll(float);

    property <color> panel-bg: root.light-theme ? #ffffff : #1a1c21;
    property <color> text-color: root.light-theme ? #102625 : #f1f3f5;
    property <color> muted-color: root.light-theme ? #688a87 : #7d838e;
    property <color> line-color: root.light-theme ? #79bbb6 : #3a3e46;
    property <color> weekend-color: root.light-theme ? #a44750 : #e5a0a0;
    property <color> selection-color: #16877f;

    Rectangle {
        width: parent.width; height: parent.height;
        border-radius: root.corner-radius * 1px;
        border-width: 1px;
        border-color: #183b38;
        background: root.panel-bg;
        clip: true;

        Rectangle { x: 0px; y: 0px; width: parent.width; height: 82px; background: root.light-theme ? @linear-gradient(180deg, #baf1ed, root.accent) : @linear-gradient(180deg, #263236, #1a1c21); }
        Text { x: 18px; y: 13px; text: "CALENDAR"; color: root.light-theme ? #176f69 : root.accent; font-family: "Carlito"; font-size: 10px; font-weight: 700; letter-spacing: 1px; }
        Text { x: 18px; y: 31px; width: 200px; height: 38px; text: root.heading; color: root.text-color; font-family: "Carlito"; font-size: 23px; font-weight: 700; vertical-alignment: center; }
        TouchArea { x: 0px; y: 0px; width: 220px; height: 82px; pointer-event(event) => { if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) { root.request-window-drag(); } } }
        CalendarButton { x: 448px; y: 25px; width: 38px; height: 34px; text: root.view == 2 ? "←" : "‹"; clicked => { root.request-previous(); } }
        CalendarButton { x: 492px; y: 25px; width: 66px; height: 34px; text: "Today"; clicked => { root.request-today(); } }
        CalendarButton { x: 564px; y: 25px; width: 38px; height: 34px; text: root.view == 2 ? "→" : "›"; clicked => { root.request-next(); } }

        Rectangle { x: 0px; y: 82px; width: parent.width; height: 12px; background: root.light-theme ? @linear-gradient(180deg, root.accent, #ffffff) : root.panel-bg; }

        CalendarButton { x: 18px; y: 99px; width: 62px; height: 34px; text: "Week"; active: root.view == 1; clicked => { root.request-view(1); } }
        CalendarButton { x: 86px; y: 99px; width: 68px; height: 34px; text: "Month"; active: root.view == 0; clicked => { root.request-view(0); } }
        CalendarButton { x: 160px; y: 99px; width: 58px; height: 34px; text: "Year"; active: root.view == 2; clicked => { root.request-view(2); } }
        // Month view
        Rectangle {
            x: 18px; y: 143px; width: 614px; height: 302px; visible: root.view == 0; background: transparent;
            for label[index] in root.weekday-labels: Text {
                x: index * 87px; y: 0px; width: 85px; height: 24px; text: label;
                color: index >= 5 ? root.weekend-color : root.muted-color; font-family: "Carlito"; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center;
            }
            for day[index] in root.days: Rectangle {
                x: (index - Math.floor(index / 7) * 7) * 87px;
                y: 27px + Math.floor(index / 7) * 43px;
                width: 85px; height: 39px; border-radius: 7px;
                border-width: day.today ? 1px : 0px; border-color: root.selection-color;
                background: day.selected ? root.selection-color : transparent;
                Text { text: day.text; color: day.selected ? white : (day.muted ? root.muted-color : (day.weekend ? root.weekend-color : root.text-color)); font-family: "Carlito"; font-size: 14px; font-weight: day.selected ? 700 : 400; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.request-select-date(day.date-id); } }
            }
        }

        // Week view
        Rectangle {
            x: 18px; y: 143px; width: 614px; height: 450px; visible: root.view == 1; background: transparent;
            for day[index] in root.week-days: Rectangle {
                x: 44px + index * 81px; y: 0px; width: 81px; height: 45px; background: transparent;
                Text { y: 0px; width: parent.width; height: 16px; text: root.weekday-labels[index]; color: day.weekend ? root.weekend-color : root.muted-color; font-family: "Carlito"; font-size: 9px; font-weight: 700; horizontal-alignment: center; }
                Rectangle { x: 28px; y: 17px; width: 24px; height: 24px; border-radius: 12px; background: day.selected ? root.selection-color : transparent; Text { text: day.text; color: day.selected ? white : root.text-color; font-family: "Carlito"; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
            }
            ScrollView {
                x: 0px; y: 46px; width: parent.width; height: 404px;
                viewport-width: parent.width - 12px;
                viewport-height: root.hour-labels.length * 34px;
                viewport-y <=> root.week-scroll-y;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                scrolled => { root.request-week-scroll(self.viewport-y / 1px); }
                for hour[index] in root.hour-labels: Text { x: 0px; y: index * 34px - 8px; width: 40px; height: 20px; text: hour; color: root.muted-color; font-family: "Carlito"; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
                for separator[index] in root.week-days: Rectangle { x: 44px + index * 81px; y: 0px; width: 1px; height: root.hour-labels.length * 34px; background: root.line-color; }
                for hour[index] in root.hour-labels: Rectangle { x: 44px; y: index * 34px; width: 567px; height: 1px; background: root.line-color; opacity: 0.18; }
                Rectangle { x: 44px; y: root.current-time-y * 1px; width: 567px; height: 2px; visible: root.current-time-y >= 0; background: root.selection-color; Rectangle { x: -39px; y: -7px; width: 36px; height: 14px; border-radius: 3px; background: root.selection-color; Text { width: parent.width; height: parent.height; text: root.current-time-label; color: white; font-family: "Carlito"; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } } }
            }
        }

        // Year view
        Rectangle {
            x: 18px; y: 143px; width: 614px; height: 390px; visible: root.view == 2; background: transparent;
            for month[index] in root.months: Rectangle {
                x: (index - Math.floor(index / 4) * 4) * 153.5px;
                y: Math.floor(index / 4) * 130px;
                width: 147.5px; height: 124px; border-radius: root.corner-radius > 0 ? 7px : 0px; border-width: 1px; border-color: root.line-color; background: transparent;
                Rectangle { x: 4px; y: 4px; width: 139.5px; height: 21px; border-radius: month.current ? 4px : 0px; background: month.current ? root.selection-color : transparent; Text { width: parent.width; height: parent.height; text: month.name; color: month.current ? white : root.text-color; font-family: "Carlito"; font-size: 14px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
                for label[label-index] in root.weekday-labels: Text { x: 5px + label-index * 19.5px; y: 28px; width: 17px; height: 12px; text: label; color: label-index >= 5 ? root.weekend-color : root.muted-color; font-family: "Carlito"; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                for day[day-index] in month.days: Rectangle {
                    x: 5px + (day-index - Math.floor(day-index / 7) * 7) * 19.5px;
                    y: 42px + Math.floor(day-index / 7) * 13px;
                    width: 17px; height: 13px; border-radius: day.selected ? 6.5px : 0px; background: day.selected ? root.selection-color : transparent;
                    Text { text: day.text; color: day.selected ? white : (day.muted ? root.muted-color : (day.weekend ? root.weekend-color : root.text-color)); font-family: "Carlito"; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                }
                TouchArea { clicked => { root.request-select-month(index); } }
            }
        }

        Text { x: 18px; y: parent.height - 35px; width: 90px; height: 22px; text: "Selected date"; color: root.muted-color; font-family: "Carlito"; font-size: 11px; vertical-alignment: center; }
        Text { x: 120px; y: parent.height - 35px; width: 512px; height: 22px; text: root.selected-label; color: root.text-color; font-family: "Carlito"; font-size: 11px; font-weight: 700; horizontal-alignment: right; vertical-alignment: center; }
        Text { x: 614px; y: 4px; width: 28px; height: 24px; text: "×"; color: root.text-color; font-family: "Carlito"; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; TouchArea { clicked => { root.request-close(); } } }
    }
}
import { ScrollView } from "std-widgets.slint";
