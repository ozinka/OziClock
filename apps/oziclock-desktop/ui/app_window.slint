import { ClockTile } from "../../../ui/clock_tile.slint";
import { RulersPanel, RulerColumnData } from "rulers_window.slint";
import { TimeSliderPanel } from "time_slider_window.slint";

export struct ClockTileData {
    label: string,
    month: string,
    day: string,
    hour: string,
    minute: string,
    second: string,
    accent: color,
    main-zone: bool,
}

export component AppWindow inherits Window {
    in property <string> product-name;
    in property <[ClockTileData]> clocks;
    in property <bool> show-seconds: true;
    in property <bool> top-most: false;
    in property <float> inactive-opacity: 1;
    in property <bool> show-rulers: false;
    in property <bool> compact-mode: false;
    in-out property <float> compact-progress: 0;
    in property <float> clock-scale: 1.0;
    in property <float> corner-radius: 12;
    in property <bool> soft-clock-style: false;
    in property <bool> modal-open: false;
    in property <[RulerColumnData]> rulers;
    in property <[int]> tick-indices;
    in property <[int]> label-hours;
    in property <[int]> hour-labels;
    in property <int> focused-column: 0;
    in-out property <float> focus-column-position: 0;
    in-out property <float> focus-progress: 0;
    in-out property <float> time-step: 0;
    in-out property <length> menu-x: 0px;
    property <length> visible-clock-height: 62px - 31px * root.compact-progress;
    pure callback format-label(int, int) -> string;
    callback request-focus-column(int);
    callback request-focus-progress(float);
    callback request-time-step(float);
    callback request-window-drag-start(float, float);
    callback request-window-drag-move(float, float);
    callback request-window-drag-end();
    callback request-open-menu();
    callback request-open-settings();
    callback request-open-about();
    callback request-exit();
    callback request-toggle-compact();
    callback request-toggle-rulers();
    callback request-toggle-top-most();
    callback request-tray-exit();
    callback request-refresh-time();

    title: product-name;
    no-frame: true;
    always-on-top: root.top-most;
    preferred-width: (100px * root.clocks.length + 1px) * root.clock-scale;
    preferred-height: (root.visible-clock-height + (root.show-rulers ? 532px : 0px)) * root.clock-scale;
    min-width: 101px * root.clock-scale;
    min-height: 31px * root.clock-scale;
    max-height: 594px * root.clock-scale;
    background: transparent;

    content := Rectangle {
        width: parent.width;
        height: parent.height;
        background: #000000;
        border-radius: root.corner-radius * 1px * root.clock-scale;
        clip: true;
        opacity: root.show-rulers || interaction.has-hover ? 1 : root.inactive-opacity;
        animate opacity { duration: 300ms; }

        clock-strip := Rectangle {
            y: -31px * root.compact-progress * root.clock-scale;
            width: parent.width;
            height: 62px * root.clock-scale;
            background: #000000;

            for clock[index] in root.clocks: Rectangle {
                x: (1px + index * 100px) * root.clock-scale;
                y: 1px * root.clock-scale;
                width: index == root.clocks.length - 1 ? parent.width - self.x : 99px * root.clock-scale;
                height: 60px * root.clock-scale;

                ClockTile {
                    width: parent.width;
                    label: clock.label;
                    month: clock.month;
                    day: clock.day;
                    hour: clock.hour;
                    minute: clock.minute;
                    second: clock.second;
                    accent: clock.accent;
                    main-zone: clock.main-zone;
                    show-seconds: root.show-seconds;
                    clock-scale: root.clock-scale;
                    soft-style: root.soft-clock-style;
                }
            }

            interaction := TouchArea {
                double-clicked => { root.request-toggle-rulers(); }
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        root.request-window-drag-start(self.mouse-x / 1px, self.mouse-y / 1px);
                    }
                    if ((event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) && event.button == PointerEventButton.left) {
                        root.request-window-drag-end();
                    }
                    if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) {
                        root.menu-x = self.mouse-x;
                        root.request-open-menu();
                    }
                    if (event.kind == PointerEventKind.up && event.button == PointerEventButton.middle) {
                        root.request-toggle-compact();
                    }
                }
                moved => { root.request-window-drag-move(self.mouse-x / 1px, self.mouse-y / 1px); }
            }
        }

        RulersPanel {
            y: root.visible-clock-height * root.clock-scale;
            visible: root.show-rulers;
            rulers: root.rulers;
            tick-indices: root.tick-indices;
            label-hours: root.label-hours;
            focused-column: root.focused-column;
            focus-column-position <=> root.focus-column-position;
            focus-progress: root.focus-progress;
            clock-scale: root.clock-scale;
            format-label(column-index, hour) => { return root.format-label(column-index, hour); }
            request-focus-column(column-index) => { root.request-focus-column(column-index); }
            request-focus-progress(progress) => { root.request-focus-progress(progress); }
        }

        TimeSliderPanel {
            y: (root.visible-clock-height + 463px) * root.clock-scale;
            visible: root.show-rulers;
            clock-count: root.clocks.length;
            hour-labels: root.hour-labels;
            clock-scale: root.clock-scale;
            corner-radius: root.corner-radius;
            time-step <=> root.time-step;
            request-time-step(value) => { root.request-time-step(value); }
        }

        Rectangle { x: 0px; y: 0px; width: 1px; height: parent.height; background: #000000; }
        Rectangle { x: parent.width - 1px; y: 0px; width: 1px; height: parent.height; background: #000000; }
        Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: #000000; }
        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: #000000; }

        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: transparent;
            border-width: 1px;
            border-color: #000000;
            border-radius: root.corner-radius * 1px * root.clock-scale;
        }

        TouchArea { visible: root.modal-open; }
    }
}
