import { ClockTile } from "../../../ui/clock_tile.slint";
import { ClockFrame } from "../../../ui/clock_frame.slint";
import { ClockStripLayout, ClockStripMetrics } from "../../../ui/clock_strip_layout.slint";
import { RulersPanel, RulerColumnData } from "rulers_window.slint";
import { TimeSliderPanel } from "time_slider_window.slint";

export struct ClockTileData {
    label: string,
    month: string,
    day: string,
    hour: string,
    minute: string,
    second: string,
    accent: color,
    main-zone: bool,
}

export component AppWindow inherits Window {
    in property <string> product-name;
    in property <[ClockTileData]> clocks;
    in property <bool> show-seconds: true;
    in property <bool> top-most: false;
    in property <float> inactive-opacity: 1;
    in property <bool> native-opacity: false;
    out property <float> effective-opacity: root.show-rulers || interaction.has-hover ? 1 : root.inactive-opacity;
    animate effective-opacity { duration: 300ms; }
    callback request-native-opacity(float);
    changed effective-opacity => {
        if (root.native-opacity) { root.request-native-opacity(root.effective-opacity); }
    }
    in property <bool> show-rulers: false;
    in property <bool> compact-mode: false;
    in-out property <float> compact-progress: 0;
    in property <float> clock-scale: 1.0;
    in property <float> corner-radius: 12;
    in property <bool> soft-clock-style: false;
    in property <color> border-color: #000000;
    in property <float> non-main-dimming: 0;
    in property <bool> modal-open: false;
    in property <[RulerColumnData]> rulers;
    in property <[int]> tick-indices;
    in property <[int]> label-hours;
    in property <[int]> hour-labels;
    in property <int> focused-column: 0;
    in-out property <float> focus-column-position: 0;
    in-out property <float> focus-progress: 0;
    in-out property <float> time-step: 0;
    in-out property <length> menu-x: 0px;
    out property <length> clock-viewport-height: Math.round((62px - 31px * root.compact-progress) * root.clock-scale / 1phx) * 1phx;
    out property <length> ruler-extension-height: Math.round(532px * root.clock-scale / 1phx) * 1phx;
    property <length> ruler-height: Math.round(463px * root.clock-scale / 1phx) * 1phx;
    out property <ClockStripMetrics> strip-metrics: {
        count: root.clocks.length,
        tile-width: Math.round(99px * root.clock-scale / 1phx) * 1phx,
        line-width: Math.max(1, Math.round(1px * root.clock-scale / 1phx)) * 1phx,
        end-padding: Math.ceil(root.corner-radius * 0.125px * root.clock-scale / 1phx) * 1phx,
    };
    pure callback format-label(int, int) -> string;
    callback request-focus-column(int);
    callback request-focus-progress(float);
    callback request-time-step(float);
    callback request-window-drag-start(float, float);
    callback request-window-drag-move(float, float);
    callback request-window-drag-end();
    callback request-clock-click();
    callback request-open-menu();
    callback request-open-settings();
    callback request-open-about();
    callback request-exit();
    callback request-toggle-compact();
    callback request-toggle-rulers();
    callback request-toggle-top-most();
    callback request-tray-exit();
    callback request-refresh-time();

    title: product-name;
    no-frame: true;
    always-on-top: root.top-most;
    out property <length> window-width: root.strip-metrics.line-width + ClockStripLayout.boundary(root.strip-metrics, root.clocks.length);
    property <length> window-height: root.clock-viewport-height + (root.show-rulers ? root.ruler-extension-height : 0px);
    preferred-width: root.window-width;
    preferred-height: root.window-height;
    min-width: root.window-width;
    max-width: root.window-width;
    min-height: root.window-height;
    max-height: root.window-height;
    background: transparent;

    content := ClockFrame {
        width: parent.width;
        height: parent.height;
        border-color: root.border-color;
        border-width: root.strip-metrics.line-width;
        border-radius: root.corner-radius * 1px * root.clock-scale;
        opacity: root.native-opacity ? 1 : root.effective-opacity;

        clock-strip := Rectangle {
            y: root.clock-viewport-height - self.height;
            width: parent.width;
            height: Math.round(62px * root.clock-scale / 1phx) * 1phx;
            background: root.border-color;

            for clock[index] in root.clocks: Rectangle {
                property <length> column-end: ClockStripLayout.boundary(root.strip-metrics, index + 1);
                x: root.strip-metrics.line-width + ClockStripLayout.boundary(root.strip-metrics, index);
                y: root.strip-metrics.line-width;
                width: self.column-end - self.x;
                height: parent.height - 2 * root.strip-metrics.line-width;
                ClockTile {
                    width: parent.width;
                    content-inset: index == 0 ? root.strip-metrics.end-padding : 0px;
                    label: clock.label;
                    month: clock.month;
                    day: clock.day;
                    hour: clock.hour;
                    minute: clock.minute;
                    second: clock.second;
                    accent: clock.accent;
                    main-zone: clock.main-zone;
                    show-seconds: root.show-seconds;
                    clock-scale: root.clock-scale;
                    soft-style: root.soft-clock-style;
                }

                dimmer := Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: #000000;
                    opacity: clock.main-zone || interaction.has-hover ? 0 : root.non-main-dimming / 100;
                    animate opacity { duration: 200ms; easing: ease-in-out; }
                }
            }

            interaction := TouchArea {
                property <bool> left-pressed: false;
                property <bool> dragged: false;
                property <float> press-x: 0;
                property <float> press-y: 0;
                clicked => { if (!self.dragged) { root.request-clock-click(); } }
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        self.left-pressed = true;
                        self.dragged = false;
                        self.press-x = self.mouse-x / 1px;
                        self.press-y = self.mouse-y / 1px;
                        root.request-window-drag-start(self.mouse-x / 1px, self.mouse-y / 1px);
                    }
                    if ((event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) && event.button == PointerEventButton.left) {
                        self.left-pressed = false;
                        root.request-window-drag-end();
                    }
                    if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) {
                        root.menu-x = self.mouse-x;
                        root.request-open-menu();
                    }
                    if (event.kind == PointerEventKind.up && event.button == PointerEventButton.middle) {
                        root.request-toggle-compact();
                    }
                }
                moved => {
                    if (self.left-pressed && (abs(self.mouse-x / 1px - self.press-x) > 1 || abs(self.mouse-y / 1px - self.press-y) > 1)) {
                        self.dragged = true;
                    }
                    root.request-window-drag-move(self.mouse-x / 1px, self.mouse-y / 1px);
                }
            }
        }

        RulersPanel {
            y: root.clock-viewport-height;
            width: parent.width;
            height: root.ruler-height;
            metrics: root.strip-metrics;
            visible: root.show-rulers;
            rulers: root.rulers;
            tick-indices: root.tick-indices;
            label-hours: root.label-hours;
            focused-column: root.focused-column;
            focus-column-position <=> root.focus-column-position;
            focus-progress: root.focus-progress;
            clock-scale: root.clock-scale;
            border-color: root.border-color;
            format-label(column-index, hour) => { return root.format-label(column-index, hour); }
            request-focus-column(column-index) => { root.request-focus-column(column-index); }
            request-focus-progress(progress) => { root.request-focus-progress(progress); }
        }

        TimeSliderPanel {
            y: root.clock-viewport-height + root.ruler-height;
            width: parent.width;
            height: root.ruler-extension-height - root.ruler-height;
            line-width: root.strip-metrics.line-width;
            visible: root.show-rulers;
            hour-labels: root.hour-labels;
            clock-scale: root.clock-scale;
            border-color: root.border-color;
            time-step <=> root.time-step;
            request-time-step(value) => { root.request-time-step(value); }
        }

        TouchArea { visible: root.modal-open; }
    }
}
