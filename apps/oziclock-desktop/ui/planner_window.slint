            VerticalLayout { padding: 8px; spacing: 2px; for mode in ["No alert", "At due time", "5 minutes before", "15 minutes before", "30 minutes before", "1 hour before"]: Rectangle { height: 32px; border-radius: 5px; background: mode == root.task-alert ? root.accent : task-alert-choice.has-hover ? #344144 : transparent; Text { x: 10px; width: parent.width - 20px; height: parent.height; text: mode; color: mode == root.task-alert ? #082725 : #dce8e5; font-size: 12px; font-weight: mode == root.task-alert ? 700 : 400; vertical-alignment: center; } task-alert-choice := TouchArea { clicked => { root.task-alert = mode; root.task-alert-menu-visible = false; } } } }
        }
    }
    if root.reminder-recurrence-menu-visible : Rectangle {
        width: parent.width; height: parent.height; background: transparent;
        TouchArea { clicked => { root.reminder-recurrence-menu-visible = false; } }
        Rectangle { x: 347px; y: parent.height - 284px; width: 150px; height: 190px; border-radius: 8px; background: #20292b; border-width: 1px; border-color: #465558; TouchArea {}
            VerticalLayout { padding: 8px; spacing: 2px; for mode in ["Once", "Daily", "Weekly", "Monthly", "Yearly"]: Rectangle { height: 32px; border-radius: 5px; background: mode == root.reminder-recurrence ? root.accent : reminder-mode-choice.has-hover ? #344144 : transparent; Text { x: 10px; width: parent.width - 20px; height: parent.height; text: mode; color: mode == root.reminder-recurrence ? #082725 : #dce8e5; font-size: 12px; font-weight: mode == root.reminder-recurrence ? 700 : 400; vertical-alignment: center; } reminder-mode-choice := TouchArea { clicked => { root.reminder-recurrence = mode; root.reminder-recurrence-menu-visible = false; } } } }
        }
    }
    if root.reminder-calendar-visible : Rectangle {
        width: parent.width; height: parent.height; background: transparent;
        TouchArea { clicked => { root.reminder-calendar-visible = false; } }
        Rectangle { x: 187px; y: parent.height - 380px; width: 300px; height: 286px; border-radius: 9px; background: #20292b; border-width: 1px; border-color: #465558;
            TouchArea {}
            Text { x: 16px; y: 12px; width: parent.width - 32px; height: 28px; text: root.reminder-calendar-title; color: #e1eae8; font-size: 15px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            Rectangle { x: 10px; y: 10px; width: 34px; height: 32px; border-radius: 5px; background: previous-month.has-hover ? #344144 : transparent; Text { width: parent.width; height: parent.height; text: "‹"; color: #c4d0ce; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; } previous-month := TouchArea { clicked => { root.request-navigate-reminder-calendar(-1); } } }
            Rectangle { x: parent.width - 44px; y: 10px; width: 34px; height: 32px; border-radius: 5px; background: next-month.has-hover ? #344144 : transparent; Text { width: parent.width; height: parent.height; text: "›"; color: #c4d0ce; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; } next-month := TouchArea { clicked => { root.request-navigate-reminder-calendar(1); } } }
            for label[index] in ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]: Text { x: 12px + index * 39px; y: 48px; width: 39px; height: 22px; text: label; color: index < 5 ? #829492 : #d96d74; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
            for day[index] in root.reminder-calendar-days: Rectangle { x: 12px + Math.mod(index, 7) * 39px; y: 72px + (index / 7) * 32px; width: 35px; height: 28px; border-radius: 5px; background: day.selected ? root.accent : day-picker.has-hover && day.enabled ? #344144 : transparent; border-width: day.today && !day.selected ? 1px : 0px; border-color: root.accent;
                Text { width: parent.width; height: parent.height; text: day.label; color: day.selected ? #082725 : !day.enabled ? #52615f : day.in-month ? #dce8e5 : #718280; font-size: 12px; font-weight: day.selected || day.today ? 700 : 400; horizontal-alignment: center; vertical-alignment: center; }
                day-picker := TouchArea { enabled: day.enabled; clicked => { root.request-select-reminder-date(day.date); } }
            }
        }
    }
    if root.menu-alarm != "" : Rectangle {
        width: parent.width; height: parent.height; background: #00000088;
        TouchArea { clicked => { root.menu-alarm = ""; } }
        Rectangle { width: 320px; height: 180px; background: #20292b; border-radius: 8px;
            TouchArea {}
            VerticalLayout { padding: 18px; spacing: 10px;
                Text { text: "Delete " + root.menu-title + "?"; color: #e1eae8; font-size: 16px; overflow: elide; }
                Rectangle { height: 32px; background: #344144; Text { text: "Cancel"; color: #e1eae8; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } TouchArea { clicked => { root.menu-alarm = ""; } } }
                Rectangle { height: 32px; Text { text: "Delete"; color: #d96d74; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } TouchArea { clicked => { root.request-delete-alarm(root.menu-alarm); root.menu-alarm = ""; } } }
            }
        }
    }
    if root.menu-timer != "" : Rectangle {
        width: parent.width; height: parent.height; background: #00000088;
        TouchArea { clicked => { root.menu-timer = ""; } }
        Rectangle { width: 320px; height: 180px; background: #20292b; border-radius: 8px;
            TouchArea {}
            VerticalLayout { padding: 18px; spacing: 10px;
                Text { text: "Delete " + root.timer-menu-title + "?"; color: #e1eae8; font-size: 16px; overflow: elide; }
                Rectangle { height: 32px; background: #344144; Text { text: "Cancel"; color: #e1eae8; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } TouchArea { clicked => { root.menu-timer = ""; } } }
                Rectangle { height: 32px; Text { text: "Delete"; color: #d96d74; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } TouchArea { clicked => { root.request-delete-timer(root.menu-timer); root.menu-timer = ""; } } }
            }
        }
    }
    if root.menu-task != "" : Rectangle {
        width: parent.width; height: parent.height; background: #00000088;
        TouchArea { clicked => { root.menu-task = ""; } }
        Rectangle { width: 320px; height: 180px; background: #20292b; border-radius: 8px;
            TouchArea {}
            VerticalLayout { padding: 18px; spacing: 10px;
                Text { text: "Delete " + root.task-menu-title + "?"; color: #e1eae8; font-size: 16px; overflow: elide; }
                Rectangle { height: 32px; background: #344144; Text { text: "Cancel"; color: #e1eae8; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } TouchArea { clicked => { root.menu-task = ""; } } }
                Rectangle { height: 32px; Text { text: "Delete"; color: #d96d74; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } TouchArea { clicked => { root.request-delete-task(root.menu-task); root.menu-task = ""; } } }
            }
        }
    }
    if root.confirm-stopwatch-reset : Rectangle {
        width: parent.width; height: parent.height; background: #00000088;
        TouchArea { clicked => { root.confirm-stopwatch-reset = false; } }
        Rectangle { width: 320px; height: 180px; background: #20292b; border-radius: 8px;
            TouchArea {}
            VerticalLayout { padding: 18px; spacing: 10px;
                Text { text: "Reset stopwatch and all laps?"; color: #e1eae8; font-size: 16px; }
                Rectangle { height: 32px; background: #344144; Text { text: "Cancel"; color: #e1eae8; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } TouchArea { clicked => { root.confirm-stopwatch-reset = false; } } }
                Rectangle { height: 32px; Text { text: "Reset"; color: #d96d74; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } TouchArea { clicked => { root.request-reset-stopwatch(); root.confirm-stopwatch-reset = false; } } }
            }
        }
    }
    if root.menu-reminder != "" : Rectangle {
        width: parent.width; height: parent.height; background: #00000088;
        TouchArea { clicked => { root.menu-reminder = ""; } }
        Rectangle { width: 320px; height: 180px; background: #20292b; border-radius: 8px; TouchArea {}
            VerticalLayout { padding: 18px; spacing: 10px;
                Text { text: "Delete " + root.reminder-menu-title + "?"; color: #e1eae8; font-size: 16px; overflow: elide; }
                Rectangle { height: 32px; background: #344144; Text { text: "Cancel"; color: #e1eae8; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } TouchArea { clicked => { root.menu-reminder = ""; } } }
                Rectangle { height: 32px; Text { text: "Delete"; color: #d96d74; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } TouchArea { clicked => { root.request-delete-reminder(root.menu-reminder); root.menu-reminder = ""; } } }
            }
        }
    }
    if root.menu-event != "" : Rectangle {
        width: parent.width; height: parent.height; background: #00000088;
        TouchArea { clicked => { root.menu-event = ""; } }
        Rectangle { width: 320px; height: 180px; background: #20292b; border-radius: 8px; TouchArea {}
            VerticalLayout { padding: 18px; spacing: 10px;
                Text { text: "Delete " + root.event-menu-title + "?"; color: #e1eae8; font-size: 16px; overflow: elide; }
                Rectangle { height: 32px; background: #344144; Text { text: "Cancel"; color: #e1eae8; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } TouchArea { clicked => { root.menu-event = ""; } } }
                Rectangle { height: 32px; Text { text: "Delete"; color: #d96d74; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } TouchArea { clicked => { root.request-delete-event(root.menu-event); root.menu-event = ""; } } }
            }
        }
    }
}
