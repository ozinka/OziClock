    in-out property <string> reminder-error: "";
    in-out property <string> reminder-recurrence: "Once";
    in-out property <bool> reminder-mon: true; in-out property <bool> reminder-tue: true; in-out property <bool> reminder-wed: true; in-out property <bool> reminder-thu: true; in-out property <bool> reminder-fri: true; in-out property <bool> reminder-sat: false; in-out property <bool> reminder-sun: false;
    in-out property <bool> reminder-recurrence-menu-visible: false;
    in property <[ReminderCalendarDayData]> reminder-calendar-days;
    in-out property <bool> reminder-calendar-visible: false;
    in property <string> reminder-calendar-title: "";
    private property <int> reminder-selected-part: 2;
    private property <string> menu-reminder: "";
    private property <string> reminder-menu-title: "";
    in property <[StopwatchLapData]> stopwatch-laps;
    in property <bool> stopwatch-has-data: false;
    private property <bool> confirm-stopwatch-reset: false;
    in property <[PlannerTaskData]> completed-tasks;
    in property <int> completed-task-count: 0;
    in-out property <bool> show-completed-tasks: false;
    in-out property <string> selected-task: "";
    in-out property <string> editing-task: "";
    in-out property <string> task-error: "";
    in-out property <bool> task-scheduled: false;
    in-out property <string> task-date-draft: "";
    in-out property <string> task-time-draft: "09:00";
    in-out property <string> task-alert: "No alert";
    in-out property <bool> task-alert-menu-visible: false;
    private property <string> menu-task: "";
    private property <string> task-menu-title: "";
    in-out property <string> editing-timer: "";
    in-out property <string> selected-timer: "";
    in-out property <string> timer-title-draft: "Timer";
    in-out property <bool> timer-repeat: false;
    in-out property <string> timer-repeat-count: "1";
    in-out property <bool> timer-repeat-unlimited: false;
    in-out property <string> timer-error: "";
    private property <string> menu-timer: "";
