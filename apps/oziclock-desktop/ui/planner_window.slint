import { LineEdit, ScrollView } from "std-widgets.slint";
import { DeleteIcon } from "delete_icon.slint";

export struct PlannerTaskData {
    id: string,
    title: string,
}

export struct PlannerTimerData {
    id: string,
    title: string,
    remaining: string,
    running: bool,
    finished: bool,
    repeat: bool,
    repeat-label: string,
}

export struct PlannerReminderData {
    id: string,
    title: string,
    due: string,
    enabled: bool,
    delivered: bool,
}

export struct ReminderCalendarDayData {
    label: string,
    date: string,
    in-month: bool,
    enabled: bool,
    selected: bool,
    today: bool,
}

export struct PlanWeekDayData { label: string, date: string, weekend: bool, today: bool }
export struct PlanReminderMarkerData { id: string, title: string, date: string, time: string, day-index: int, minute-offset: int, lane-index: int, lane-count: int }
export struct PlanEventMarkerData { id: string, title: string, date: string, time: string, day-index: int, minute-offset: int, duration-minutes: int, lane-index: int, lane-count: int }
export struct PlanAllDayEventData { id: string, title: string, date: string, day-index: int }

export struct PlannerAlarmData {
    id: string,
    title: string,
    schedule: string,
    time: string,
    status: string,
    weekly: bool,
    weekdays: [bool],
    enabled: bool,
}

export struct StopwatchLapData {
    number: int,
    total: string,
    split: string,
    fastest: bool,
    slowest: bool,
}

component TimeSegmentField inherits Rectangle {
    in property <length> text-offset: 0px;
    in property <string> label;
    in-out property <string> value;
    in property <bool> selected;
    callback selected-field();
    callback edited(string);
    callback request-adjust(int);
    width: 52px;
    height: 54px;
    Text { x: 0px; y: 0px; width: parent.width; height: 16px; text: root.label; color: #a7b7b4; font-size: 11px; horizontal-alignment: center; vertical-alignment: center;
        TouchArea { clicked => { input.focus(); root.selected-field(); } }
    }
    Rectangle { y: 18px; width: parent.width; height: 36px; border-radius: 5px; background: root.selected ? #38414c : transparent;
        input := TextInput {
            y: root.text-offset;
            width: parent.width; height: parent.height;
            text <=> root.value; font-size: 20px; font-weight: 500;
            color: root.selected ? #b5d6f5 : #e1eae8;
            selection-background-color: #5b9bd5; selection-foreground-color: #13191b;
            horizontal-alignment: center; vertical-alignment: center; single-line: true;
            accessible-label: root.label;
            changed has-focus => { if self.has-focus { root.selected-field(); } }
            edited => { root.edited(self.text); }
            key-pressed(event) => {
                if event.text == Key.UpArrow { root.request-adjust(1); return accept; }
                if event.text == Key.DownArrow { root.request-adjust(-1); return accept; }
                return reject;
            }
        }
    }
}

component SidebarSectionIcon inherits Rectangle {
    in property <int> section;
    in property <color> icon-color;
    width: 20px; height: 20px; background: transparent;
    // Plan
    if root.section == 0: Rectangle { x: 2px; y: 3px; width: 16px; height: 15px; border-radius: 3px; border-width: 1px; border-color: root.icon-color; background: transparent; Rectangle { x: 3px; y: 5px; width: 10px; height: 1px; background: root.icon-color; } Rectangle { x: 4px; y: -2px; width: 2px; height: 5px; border-radius: 1px; background: root.icon-color; } Rectangle { x: 10px; y: -2px; width: 2px; height: 5px; border-radius: 1px; background: root.icon-color; } }
    // Alarm
    if root.section == 1: Rectangle { x: 3px; y: 3px; width: 14px; height: 14px; border-radius: 7px; border-width: 1px; border-color: root.icon-color; background: transparent; Rectangle { x: 6px; y: 3px; width: 1px; height: 5px; background: root.icon-color; } Rectangle { x: 6px; y: 7px; width: 4px; height: 1px; background: root.icon-color; } }
    // Timer and stopwatch share the attention clock silhouette.
    if root.section == 2 || root.section == 3: Rectangle { x: 2px; y: 3px; width: 16px; height: 16px; border-radius: 8px; border-width: 1px; border-color: root.icon-color; background: transparent; Rectangle { x: 7px; y: -3px; width: 2px; height: 4px; background: root.icon-color; } Rectangle { x: 7px; y: 3px; width: 1px; height: 6px; background: root.icon-color; } Rectangle { x: 7px; y: 8px; width: 5px; height: 1px; background: root.icon-color; } }
    // Reminder clipboard
    if root.section == 4: Rectangle { x: 3px; y: 2px; width: 14px; height: 17px; border-radius: 2px; border-width: 1px; border-color: root.icon-color; background: transparent; Rectangle { x: 4px; y: -2px; width: 6px; height: 4px; border-radius: 2px; background: root.icon-color; } Rectangle { x: 4px; y: 6px; width: 7px; height: 1px; background: root.icon-color; } Rectangle { x: 4px; y: 10px; width: 7px; height: 1px; background: root.icon-color; } }
    // Task
    if root.section == 5: Rectangle { x: 2px; y: 2px; width: 16px; height: 16px; border-radius: 8px; border-width: 1px; border-color: root.icon-color; background: transparent; Text { width: parent.width; height: parent.height; text: "✓"; color: root.icon-color; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
}

