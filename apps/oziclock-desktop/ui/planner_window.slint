    in-out property <int> editor-modal: -1;
    callback close-editor();
    close-editor => { root.editor-modal = -1; root.editing-alarm = ""; root.editing-timer = ""; root.editing-reminder = ""; root.editing-task = ""; root.editing-event = ""; root.alarm-error = ""; root.timer-error = ""; root.reminder-error = ""; root.task-error = ""; root.event-error = ""; root.event-recurrence-menu-visible = false; root.event-alert-menu-visible = false; }
