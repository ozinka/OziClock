import { LineEdit, ScrollView } from "std-widgets.slint";
import { DeleteIcon } from "delete_icon.slint";

export struct PlannerTaskData {
    id: string,
    title: string,
}

export struct PlannerTimerData {
    id: string,
    title: string,
    remaining: string,
    running: bool,
    finished: bool,
    repeat: bool,
}

export struct PlannerReminderData {
    id: string,
    title: string,
    due: string,
    enabled: bool,
    delivered: bool,
}

export struct ReminderCalendarDayData {
    label: string,
    date: string,
    in-month: bool,
    enabled: bool,
    selected: bool,
    today: bool,
}

export struct PlannerAlarmData {
    id: string,
    title: string,
    schedule: string,
    time: string,
    status: string,
    weekly: bool,
    weekdays: [bool],
    enabled: bool,
}

export struct StopwatchLapData {
    number: int,
    total: string,
    split: string,
    fastest: bool,
    slowest: bool,
}

component TimeSegmentField inherits Rectangle {
    in property <length> text-offset: 0px;
    in property <string> label;
    in-out property <string> value;
    in property <bool> selected;
    callback selected-field();
    callback edited(string);
    callback request-adjust(int);
    width: 52px;
    height: 54px;
    Text { x: 0px; y: 0px; width: parent.width; height: 16px; text: root.label; color: #a7b7b4; font-size: 11px; horizontal-alignment: center; vertical-alignment: center;
        TouchArea { clicked => { input.focus(); root.selected-field(); } }
    }
    Rectangle { y: 18px; width: parent.width; height: 36px; border-radius: 5px; background: root.selected ? #38414c : transparent;
        input := TextInput {
            y: root.text-offset;
            width: parent.width; height: parent.height;
            text <=> root.value; font-size: 20px; font-weight: 500;
            color: root.selected ? #b5d6f5 : #e1eae8;
            selection-background-color: #5b9bd5; selection-foreground-color: #13191b;
            horizontal-alignment: center; vertical-alignment: center; single-line: true;
            accessible-label: root.label;
            changed has-focus => { if self.has-focus { root.selected-field(); } }
            edited => { root.edited(self.text); }
            key-pressed(event) => {
                if event.text == Key.UpArrow { root.request-adjust(1); return accept; }
                if event.text == Key.DownArrow { root.request-adjust(-1); return accept; }
                return reject;
            }
        }
    }
}

component SidebarSectionIcon inherits Rectangle {
    in property <int> section;
    in property <color> icon-color;
    width: 20px; height: 20px; background: transparent;
    // Plan
    if root.section == 0: Rectangle { x: 2px; y: 3px; width: 16px; height: 15px; border-radius: 3px; border-width: 1px; border-color: root.icon-color; background: transparent; Rectangle { x: 3px; y: 5px; width: 10px; height: 1px; background: root.icon-color; } Rectangle { x: 4px; y: -2px; width: 2px; height: 5px; border-radius: 1px; background: root.icon-color; } Rectangle { x: 10px; y: -2px; width: 2px; height: 5px; border-radius: 1px; background: root.icon-color; } }
    // Alarm
    if root.section == 1: Rectangle { x: 3px; y: 3px; width: 14px; height: 14px; border-radius: 7px; border-width: 1px; border-color: root.icon-color; background: transparent; Rectangle { x: 6px; y: 3px; width: 1px; height: 5px; background: root.icon-color; } Rectangle { x: 6px; y: 7px; width: 4px; height: 1px; background: root.icon-color; } }
    // Timer and stopwatch share the attention clock silhouette.
    if root.section == 2 || root.section == 3: Rectangle { x: 2px; y: 3px; width: 16px; height: 16px; border-radius: 8px; border-width: 1px; border-color: root.icon-color; background: transparent; Rectangle { x: 7px; y: -3px; width: 2px; height: 4px; background: root.icon-color; } Rectangle { x: 7px; y: 3px; width: 1px; height: 6px; background: root.icon-color; } Rectangle { x: 7px; y: 8px; width: 5px; height: 1px; background: root.icon-color; } }
    // Reminder clipboard
    if root.section == 4: Rectangle { x: 3px; y: 2px; width: 14px; height: 17px; border-radius: 2px; border-width: 1px; border-color: root.icon-color; background: transparent; Rectangle { x: 4px; y: -2px; width: 6px; height: 4px; border-radius: 2px; background: root.icon-color; } Rectangle { x: 4px; y: 6px; width: 7px; height: 1px; background: root.icon-color; } Rectangle { x: 4px; y: 10px; width: 7px; height: 1px; background: root.icon-color; } }
    // Task
    if root.section == 5: Rectangle { x: 2px; y: 2px; width: 16px; height: 16px; border-radius: 8px; border-width: 1px; border-color: root.icon-color; background: transparent; Text { width: parent.width; height: parent.height; text: "✓"; color: root.icon-color; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
}

export component PlannerWindow inherits Window {
    in property <[PlannerReminderData]> reminders;
    in-out property <string> selected-reminder: "";
    in-out property <string> editing-reminder: "";
    in-out property <string> reminder-title-draft: "Reminder";
    in-out property <string> reminder-date-draft: "";
    in-out property <string> reminder-hours-draft: "00";
    in-out property <string> reminder-minutes-draft: "00";
    in-out property <string> reminder-error: "";
    in property <[ReminderCalendarDayData]> reminder-calendar-days;
    in-out property <bool> reminder-calendar-visible: false;
    in property <string> reminder-calendar-title: "";
    private property <int> reminder-selected-part: 2;
    private property <string> menu-reminder: "";
    private property <string> reminder-menu-title: "";
    in property <[StopwatchLapData]> stopwatch-laps;
    in property <bool> stopwatch-has-data: false;
    private property <bool> confirm-stopwatch-reset: false;
    in property <[PlannerTaskData]> completed-tasks;
    in property <int> completed-task-count: 0;
    in-out property <bool> show-completed-tasks: false;
    in-out property <string> selected-task: "";
    in-out property <string> editing-task: "";
    in-out property <string> task-error: "";
    private property <string> menu-task: "";
    private property <string> task-menu-title: "";
    in-out property <string> editing-timer: "";
    in-out property <string> selected-timer: "";
    in-out property <string> timer-title-draft: "Timer";
    in-out property <bool> timer-repeat: false;
    in-out property <string> timer-error: "";
    private property <string> menu-timer: "";
    private property <string> timer-menu-title: "";
    in-out property <string> editing-alarm: "";
    in-out property <string> selected-alarm: "";
    in-out property <string> alarm-error: "";
    private property <string> menu-alarm: "";
    private property <string> menu-title: "";
    callback request-edit-alarm(string);
    callback request-delete-alarm(string);
    callback request-alarm-section-enter();
    private property <int> timer-selected-part: 2;
    in-out property <string> alarm-hours-draft: "07";
    in-out property <string> alarm-minutes-draft: "00";
    private property <int> alarm-selected-part: 1;
    callback request-adjust-alarm-part(int, int);
    callback request-edit-timer-part(int, string);
    title: "OziClock Planner"; no-frame: true;
    preferred-width: 900px; preferred-height: 780px; min-width: 900px; min-height: 780px; background: transparent;
    in property <color> accent: #77d7cb; in property <float> corner-radius: 12; in-out property <int> selected-view: 0; in-out property <int> selected-section: 0; in property <int> task-count: 0; in property <[PlannerTaskData]> tasks; in property <[PlannerTimerData]> timers; in property <[PlannerAlarmData]> alarms; in property <string> stopwatch-time: "00:00:00"; in property <string> stopwatch-milliseconds: ".00"; in property <bool> stopwatch-running: false; in-out property <string> task-draft: ""; in-out property <string> timer-days-draft: "0"; in-out property <string> timer-hours-draft: "0"; in-out property <string> timer-minutes-draft: "5"; in-out property <string> timer-seconds-draft: "0"; in-out property <string> alarm-title-draft: "Alarm"; private property <string> alarm-time-draft: root.alarm-hours-draft + ":" + root.alarm-minutes-draft; in-out property <bool> alarm-weekly: false; in-out property <bool> alarm-mon: true; in-out property <bool> alarm-tue: true; in-out property <bool> alarm-wed: true; in-out property <bool> alarm-thu: true; in-out property <bool> alarm-fri: true; in-out property <bool> alarm-sat: false; in-out property <bool> alarm-sun: false;
    callback request-close(); callback request-window-drag(); callback request-add-task(string); callback request-complete-task(string); callback request-reopen-task(string); callback request-archive-task(string); callback request-edit-task(string); callback request-delete-task(string); callback request-add-timer(string, string, string, string, string, bool); callback request-adjust-timer-part(int, int); callback request-toggle-timer(string); callback request-reset-timer(string); callback request-edit-timer(string); callback request-delete-timer(string); callback request-add-reminder(string, string, string, string); callback request-adjust-reminder-part(int, int); callback request-reminder-section-enter(); callback request-open-reminder-calendar(); callback request-navigate-reminder-calendar(int); callback request-select-reminder-date(string); callback request-toggle-reminder(string, bool); callback request-edit-reminder(string); callback request-delete-reminder(string); callback request-add-alarm(string, string, bool, bool, bool, bool, bool, bool, bool, bool); callback request-toggle-alarm(string, bool); callback request-toggle-stopwatch(); callback request-reset-stopwatch(); callback request-stopwatch-lap(); callback request-undo-stopwatch-lap(); callback request-clear-stopwatch-laps();
    Rectangle { width: parent.width; height: parent.height; border-radius: root.corner-radius * 1px; background: #171d1f; border-width: 1px; border-color: #344144; clip: true;
        // Background hit target stays behind all interactive children.
        // Leave the outer edge available for native window resizing.
        TouchArea {
            x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    root.request-window-drag();
                }
            }
        }
        Rectangle { x: 0px; y: 0px; width: 166px; height: parent.height; background: #13191b; VerticalLayout { padding: 14px; spacing: 7px;
                Text { text: "Planner"; color: #edf4f2; font-family: "Carlito"; font-size: 21px; font-weight: 700; }
                Text { text: "Personal time tools"; color: #839694; font-family: "Carlito"; font-size: 12px; }
                Rectangle { height: 12px; }
                for label[index] in ["Plan", "Alarms", "Timers", "Stopwatch", "Reminders", "Tasks"]: Rectangle { height: 34px; border-radius: 6px; background: index == root.selected-section ? root.accent : transparent;
                    SidebarSectionIcon { x: 9px; y: 7px; section: index; icon-color: index == root.selected-section ? #082725 : #829492; }
                    Text { x: 38px; width: parent.width - 46px; height: parent.height; text: label; vertical-alignment: center; color: index == root.selected-section ? #082725 : #b8c7c4; font-family: "Carlito"; font-size: 14px; }
                    TouchArea { clicked => { if index == 1 && root.selected-section != 1 { root.request-alarm-section-enter(); } if index == 4 && root.selected-section != 4 { root.request-reminder-section-enter(); } if root.selected-section == 5 && index != 5 { root.selected-task = ""; root.editing-task = ""; root.task-error = ""; root.task-draft = ""; } if root.selected-section == 4 && index != 4 { root.selected-reminder = ""; root.editing-reminder = ""; root.reminder-error = ""; root.reminder-title-draft = "Reminder"; } root.selected-section = index; } }
                }
                Rectangle { vertical-stretch: 1; } Text { text: "Local-first"; color: #60716f; font-size: 11px; }
        }}
        Rectangle { x: 166px; y: 0px; width: 1px; height: parent.height; background: #344144; }
        Rectangle { x: 167px; y: 0px; width: parent.width - 167px; height: parent.height;
            VerticalLayout { padding: 20px; spacing: 14px;
                HorizontalLayout { Text { text: root.selected-section == 5 ? "Tasks" : root.selected-section == 4 ? "Reminders" : root.selected-section == 3 ? "Stopwatch" : root.selected-section == 2 ? "Timers" : root.selected-section == 1 ? "Alarms" : "Plan"; color: #edf4f2; font-family: "Carlito"; font-size: 25px; font-weight: 700; } Rectangle { horizontal-stretch: 1; } Text { text: "×"; color: #aab9b7; font-size: 25px; TouchArea { clicked => { root.request-close(); } } } }
                HorizontalLayout { visible: root.selected-section == 0; height: 30px; vertical-stretch: 0; spacing: 6px;
                    for label[index] in ["Week", "Month", "Year"]: Rectangle { width: 66px; height: 30px; border-radius: 6px; background: index == root.selected-view ? root.accent : #20292b;
                        Text { width: parent.width; height: parent.height; text: label; horizontal-alignment: center; vertical-alignment: center; color: index == root.selected-view ? #082725 : #c4d0ce; font-size: 12px; font-weight: 700; }
                        TouchArea { clicked => { root.selected-view = index; } }
                    }
                    Rectangle { horizontal-stretch: 1; } Text { text: "‹   This week   ›"; color: #c4d0ce; font-size: 13px; }
                }
                if root.selected-section != 5 : Rectangle { height: 1px; background: #344144; }
                if root.selected-section == 0 && root.selected-view == 0 : Rectangle { vertical-stretch: 1; border-radius: 8px; background: #1b2325; border-width: 1px; border-color: #344144;
                    VerticalLayout { padding-left: 6px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px; spacing: 0;
                        HorizontalLayout { height: 34px; Text { width: 48px; } Rectangle { width: 6px; } for day in ["Mon 31", "Tue 1", "Wed 2", "Thu 3", "Fri 4", "Sat 5", "Sun 6"]: Text { horizontal-stretch: 1; height: parent.height; text: day; horizontal-alignment: center; vertical-alignment: center; color: #aab9b7; font-size: 11px; } }
                        for hour in ["09:00", "10:00", "11:00", "12:00", "13:00", "14:00", "15:00", "16:00", "17:00"]: HorizontalLayout { min-height: 42px; vertical-stretch: 1; Text { width: 48px; text: hour; color: #829492; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; } Rectangle { width: 6px; } for day in [0, 1, 2, 3, 4, 5, 6]: Rectangle { horizontal-stretch: 1; border-width: 1px; border-color: #293436; } }
                    }
                }
                if root.selected-section == 0 && root.selected-view != 0 : Rectangle { vertical-stretch: 1; border-radius: 8px; background: #1b2325; Text { width: parent.width; height: parent.height; text: root.selected-view == 1 ? "Month view" : "Year view"; horizontal-alignment: center; vertical-alignment: center; color: #829492; font-size: 15px; } }
                if root.selected-section == 5 : Rectangle { vertical-stretch: 1; border-radius: 8px; background: #1b2325; border-width: 1px; border-color: #344144;
                    HorizontalLayout { x: 14px; y: 10px; width: parent.width - 28px; height: 30px; spacing: 6px;
                        for label[index] in ["Open " + root.task-count, "Completed " + root.completed-task-count]: Rectangle { width: 112px; border-radius: 5px; background: (index == 1) == root.show-completed-tasks ? root.accent : #20292b; Text { width: parent.width; height: parent.height; text: label; color: (index == 1) == root.show-completed-tasks ? #082725 : #c4d0ce; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.show-completed-tasks = index == 1; root.selected-task = ""; root.editing-task = ""; root.task-error = ""; } } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    ScrollView { visible: !root.show-completed-tasks; x: 14px; y: 48px; width: parent.width - 28px; height: parent.height - 62px; viewport-width: self.width; viewport-height: root.tasks.length * 43px; horizontal-scrollbar-policy: ScrollBarPolicy.always-off; vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                        for task[index] in root.tasks: Rectangle { y: index * 43px; width: parent.width - 14px; height: 36px; border-radius: 6px; background: root.selected-task == task.id ? #293638 : #20292b; border-width: root.editing-task == task.id ? 1px : 0px; border-color: root.accent;
                            TouchArea { x: 34px; width: parent.width - 78px; clicked => { root.selected-task = root.selected-task == task.id ? "" : task.id; root.editing-task = ""; root.task-error = ""; } }
                            Rectangle { x: 10px; y: 9px; width: 18px; height: 18px; border-radius: 9px; border-width: 1px; border-color: root.accent; background: transparent; TouchArea { clicked => { root.request-complete-task(task.id); } } }
                            Text { x: 38px; width: parent.width - 84px; height: parent.height; text: task.title; color: #d7e2df; font-size: 13px; vertical-alignment: center; overflow: elide; }
                            Rectangle { x: parent.width - 40px; y: 3px; width: 30px; height: 30px; DeleteIcon { x: 8px; y: 6px; } TouchArea { clicked => { root.menu-task = task.id; root.task-menu-title = task.title; } } }
                        }
                    }
                    ScrollView { visible: root.show-completed-tasks; x: 14px; y: 48px; width: parent.width - 28px; height: parent.height - 62px; viewport-width: self.width; viewport-height: root.completed-tasks.length * 43px; horizontal-scrollbar-policy: ScrollBarPolicy.always-off; vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                        for task[index] in root.completed-tasks: Rectangle { y: index * 43px; width: parent.width - 14px; height: 36px; border-radius: 6px; background: root.selected-task == task.id ? #293638 : #20292b;
                            Text { x: 10px; width: parent.width - 224px; height: parent.height; text: task.title; color: #aab9b7; font-size: 13px; vertical-alignment: center; overflow: elide; }
                            Rectangle { x: parent.width - 210px; y: 4px; width: 62px; height: 28px; border-radius: 5px; background: root.accent; Text { width: parent.width; height: parent.height; text: "Reopen"; color: #082725; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.request-reopen-task(task.id); } } }
                            Rectangle { x: parent.width - 142px; y: 4px; width: 88px; height: 28px; border-radius: 5px; background: #344144; Text { width: parent.width; height: parent.height; text: "Archive"; color: #dce8e5; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.request-archive-task(task.id); } } }
                            Rectangle { x: parent.width - 44px; y: 3px; width: 30px; height: 30px; DeleteIcon { x: 8px; y: 6px; } TouchArea { clicked => { root.menu-task = task.id; root.task-menu-title = task.title; } } }
                        }
                    }
                    Text { x: 14px; y: 52px; visible: !root.show-completed-tasks && root.tasks.length == 0; text: "All clear — no open tasks."; color: #718280; font-size: 13px; }
                    Text { x: 14px; y: 52px; visible: root.show-completed-tasks && root.completed-tasks.length == 0; text: "No completed tasks yet."; color: #718280; font-size: 13px; }
                }
                if root.selected-section == 1 : Rectangle { vertical-stretch: 1; border-radius: 8px; background: #1b2325; border-width: 1px; border-color: #344144;
                    Text { x: 14px; y: 14px; text: "Saved alarms"; color: #e0eae8; font-size: 13px; font-weight: 700; }
                    ScrollView { x: 14px; y: 40px; width: parent.width - 28px; height: parent.height - 54px; viewport-width: self.width; viewport-height: root.alarms.length * 50px; horizontal-scrollbar-policy: ScrollBarPolicy.always-off; vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                        for alarm[index] in root.alarms: Rectangle { x: 0px; y: index * 50px; width: parent.width - 14px; height: 43px; border-radius: 6px; background: root.selected-alarm == alarm.id ? #293638 : #20292b; border-width: root.editing-alarm == alarm.id ? 1px : 0px; border-color: root.accent;
                            TouchArea { width: parent.width - 116px; height: parent.height; clicked => { if root.selected-alarm == alarm.id { root.selected-alarm = ""; root.editing-alarm = ""; root.alarm-error = ""; root.alarm-title-draft = "Alarm"; } else { root.selected-alarm = alarm.id; root.editing-alarm = ""; root.alarm-error = ""; } } }
                            Text { x: 10px; y: 5px; width: parent.width - 300px; height: 17px; text: alarm.title; color: #d7e2df; font-size: 13px; font-weight: 700; overflow: elide; }
                            Text { x: 10px; y: 22px; width: 46px; height: 16px; text: alarm.weekly ? "Weekly ·" : "Once ·"; color: alarm.weekly ? root.accent : #829492; font-size: 11px; }
                            Text { x: 58px; y: 22px; width: parent.width - 218px; height: 16px; visible: !alarm.weekly; text: alarm.schedule; color: #829492; font-size: 13px; }
                            for label[day] in ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]: Text { x: 58px + day * 31px; y: 22px; width: 30px; height: 16px; visible: alarm.weekly && alarm.weekdays[day]; text: label; color: day < 5 ? #5b9bd5 : #d96d74; font-size: 11px; font-weight: 700; }
                            Text { x: parent.width - 286px; y: 2px; width: 96px; height: parent.height; text: alarm.status; color: alarm.status == "Missed" ? #d96d74 : root.accent; font-size: 11px; font-weight: 700; horizontal-alignment: right; vertical-alignment: center; }
                            Text { x: parent.width - 180px; y: 2px; width: 62px; height: parent.height; text: alarm.time; color: #829492; font-size: 14px; vertical-alignment: center; horizontal-alignment: right; }
                            Rectangle { x: parent.width - 104px; y: 8px; width: 62px; height: 27px; border-radius: 5px; background: alarm.enabled ? root.accent : #344144; Text { y: 2px; width: parent.width; height: parent.height; text: alarm.enabled ? "On" : "Off"; horizontal-alignment: center; vertical-alignment: center; color: alarm.enabled ? #082725 : #dce8e5; font-size: 11px; font-weight: 700; } TouchArea { clicked => { root.request-toggle-alarm(alarm.id, !alarm.enabled); } } }
                            Rectangle { x: parent.width - 36px; y: 7px; width: 30px; height: 30px; DeleteIcon { x: 8px; y: 6px; } TouchArea { clicked => { root.menu-alarm = alarm.id; root.menu-title = alarm.title; } } }
                        }
                    }
                    Text { x: 14px; y: 40px; visible: root.alarms.length == 0; text: "Create your first alarm below."; color: #718280; font-size: 13px; }
                }
                if root.selected-section == 2 : Rectangle { vertical-stretch: 1; border-radius: 8px; background: #1b2325; border-width: 1px; border-color: #344144;
                    Text { x: 14px; y: 12px; text: "Saved timers"; color: #e0eae8; font-size: 13px; font-weight: 700; }
                    ScrollView { x: 14px; y: 38px; width: parent.width - 28px; height: parent.height - 52px; viewport-width: self.width; viewport-height: root.timers.length * 51px; horizontal-scrollbar-policy: ScrollBarPolicy.always-off; vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                        for timer[index] in root.timers: Rectangle { y: index * 51px; width: parent.width - 14px; height: 44px; border-radius: 6px; background: root.selected-timer == timer.id ? #293638 : #20292b; border-width: root.editing-timer == timer.id ? 1px : 0px; border-color: root.accent;
                            TouchArea { x: 0px; width: parent.width - 190px; clicked => { root.selected-timer = root.selected-timer == timer.id ? "" : timer.id; } }
                            Text { x: 10px; y: timer.repeat ? 3px : 0px; width: parent.width - 282px; height: timer.repeat ? 23px : parent.height; text: timer.title; color: #d7e2df; font-size: 13px; vertical-alignment: center; overflow: elide; }
                            Text { x: 10px; y: 23px; visible: timer.repeat; text: "Repeat"; color: root.accent; font-size: 11px; }
                            Text { x: parent.width - 272px; width: 82px; height: parent.height; text: timer.remaining; color: timer.running ? root.accent : #aab9b7; font-size: 13px; font-weight: 700; horizontal-alignment: right; vertical-alignment: center; }
                            Rectangle { x: parent.width - 180px; y: 8px; width: 48px; height: 27px; border-radius: 5px; background: #344144; Text { width: parent.width; height: parent.height; text: "Reset"; horizontal-alignment: center; vertical-alignment: center; color: #dce8e5; font-size: 11px; } TouchArea { clicked => { root.request-reset-timer(timer.id); } } }
