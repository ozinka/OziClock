    callback request-adjust-alarm-part(int, int);
    callback request-edit-alarm-part(int, string);
    callback request-edit-reminder-part(int, string);
    callback request-edit-event-time(int, string);
    callback request-edit-timer-part(int, string);
    title: "OziClock Planner"; no-frame: true;
    preferred-width: 900px; preferred-height: 780px; min-width: 900px; min-height: 780px; background: transparent;
    in property <color> accent: #77d7cb; in property <float> corner-radius: 12; in-out property <int> selected-view: 0; in-out property <int> selected-section: 0; in property <int> task-count: 0; in property <[PlannerTaskData]> tasks; in property <[PlannerTimerData]> timers; in property <[PlannerAlarmData]> alarms; in property <string> stopwatch-time: "00:00:00"; in property <string> stopwatch-milliseconds: ".00"; in property <bool> stopwatch-running: false; in-out property <string> task-draft: ""; in-out property <string> timer-days-draft: "0"; in-out property <string> timer-hours-draft: "0"; in-out property <string> timer-minutes-draft: "5"; in-out property <string> timer-seconds-draft: "0"; in-out property <string> alarm-title-draft: "Alarm"; private property <string> alarm-time-draft: root.alarm-hours-draft + ":" + root.alarm-minutes-draft; in-out property <bool> alarm-weekly: false; in-out property <bool> alarm-mon: true; in-out property <bool> alarm-tue: true; in-out property <bool> alarm-wed: true; in-out property <bool> alarm-thu: true; in-out property <bool> alarm-fri: true; in-out property <bool> alarm-sat: false; in-out property <bool> alarm-sun: false;
    callback request-close(); callback request-window-drag(); callback request-plan-week(int); callback request-new-event(string, int); callback request-edit-event(string); callback request-adjust-event-time(int, int); callback request-save-event(string, string, string, string, string, bool, string, string); callback request-delete-event(string); callback request-add-task(string, bool, string, string, string); callback request-complete-task(string); callback request-reopen-task(string); callback request-archive-task(string); callback request-edit-task(string); callback request-delete-task(string); callback request-add-timer(string, string, string, string, string, bool); callback request-adjust-timer-part(int, int); callback request-toggle-timer(string); callback request-reset-timer(string); callback request-edit-timer(string); callback request-delete-timer(string); callback request-add-reminder(string, string, string, string, string, bool, bool, bool, bool, bool, bool, bool); callback request-adjust-reminder-part(int, int); callback request-reminder-section-enter(); callback request-open-reminder-calendar(); callback request-navigate-reminder-calendar(int); callback request-select-reminder-date(string); callback request-toggle-reminder(string, bool); callback request-edit-reminder(string); callback request-delete-reminder(string); callback request-add-alarm(string, string, bool, bool, bool, bool, bool, bool, bool, bool); callback request-toggle-alarm(string, bool); callback request-toggle-stopwatch(); callback request-reset-stopwatch(); callback request-stopwatch-lap(); callback request-undo-stopwatch-lap(); callback request-clear-stopwatch-laps();
    Rectangle { width: parent.width; height: parent.height; border-radius: root.corner-radius * 1px; background: #171d1f; border-width: 1px; border-color: #344144; clip: true;
        // Background hit target stays behind all interactive children.
        // Leave the outer edge available for native window resizing.
        TouchArea {
            x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    root.request-window-drag();
                }
            }
        }
        Rectangle { x: 0px; y: 0px; width: 166px; height: parent.height; background: #13191b; VerticalLayout { padding: 14px; spacing: 7px;
                Text { text: "Planner"; color: #edf4f2; font-family: "Carlito"; font-size: 21px; font-weight: 700; }
                Text { text: "Personal time tools"; color: #839694; font-family: "Carlito"; font-size: 12px; }
                Rectangle { height: 12px; }
                for label[index] in ["Plan", "Alarms", "Reminders", "Tasks"]: Rectangle { height: 34px; border-radius: 6px; private property <int> section: index < 2 ? index : index + 2; background: self.section == root.selected-section ? root.accent : transparent;
                    SidebarSectionIcon { x: 9px; y: 7px; section: parent.section; icon-color: parent.section == root.selected-section ? #082725 : #829492; }
                    Text { x: 38px; width: parent.width - 46px; height: parent.height; text: label; vertical-alignment: center; color: parent.section == root.selected-section ? #082725 : #b8c7c4; font-family: "Carlito"; font-size: 14px; }
                    TouchArea { clicked => { if parent.section == 1 && root.selected-section != 1 { root.request-alarm-section-enter(); } if parent.section == 4 && root.selected-section != 4 { root.request-reminder-section-enter(); } if root.selected-section == 5 && parent.section != 5 { root.selected-task = ""; root.editing-task = ""; root.task-error = ""; root.task-draft = ""; } if root.selected-section == 4 && parent.section != 4 { root.selected-reminder = ""; root.editing-reminder = ""; root.reminder-error = ""; root.reminder-title-draft = "Reminder"; } root.selected-section = parent.section; } }
                }
                Rectangle { height: 1px; background: #2b3739; }
                for label[index] in ["Timers", "Stopwatch"]: Rectangle { height: 34px; border-radius: 6px; private property <int> section: index + 2; background: self.section == root.selected-section ? root.accent : transparent;
                    SidebarSectionIcon { x: 9px; y: 7px; section: parent.section; icon-color: parent.section == root.selected-section ? #082725 : #829492; }
                    Text { x: 38px; width: parent.width - 46px; height: parent.height; text: label; vertical-alignment: center; color: parent.section == root.selected-section ? #082725 : #b8c7c4; font-family: "Carlito"; font-size: 14px; }
                    TouchArea { clicked => { if root.selected-section == 5 { root.selected-task = ""; root.editing-task = ""; root.task-error = ""; root.task-draft = ""; } if root.selected-section == 4 { root.selected-reminder = ""; root.editing-reminder = ""; root.reminder-error = ""; root.reminder-title-draft = "Reminder"; } root.selected-section = parent.section; } }
                }
                Rectangle { vertical-stretch: 1; }
        }}
        Rectangle { x: 166px; y: 0px; width: 1px; height: parent.height; background: #344144; }
        Rectangle { x: 167px; y: 0px; width: parent.width - 167px; height: parent.height;
            VerticalLayout { padding: 20px; spacing: 14px;
                HorizontalLayout { Text { text: root.selected-section == 5 ? "Tasks" : root.selected-section == 4 ? "Reminders" : root.selected-section == 3 ? "Stopwatch" : root.selected-section == 2 ? "Timers" : root.selected-section == 1 ? "Alarms" : "Plan"; color: #edf4f2; font-family: "Carlito"; font-size: 25px; font-weight: 700; } Rectangle { horizontal-stretch: 1; } Text { text: "×"; color: #aab9b7; font-size: 25px; TouchArea { clicked => { root.request-close(); } } } }
                HorizontalLayout { visible: root.selected-section == 0; height: 30px; vertical-stretch: 0; spacing: 6px;
                    for label[index] in ["Week", "Month", "Year"]: Rectangle { width: 66px; height: 30px; border-radius: 6px; background: index == root.selected-view ? root.accent : #20292b;
                        Text { width: parent.width; height: parent.height; text: label; horizontal-alignment: center; vertical-alignment: center; color: index == root.selected-view ? #082725 : #c4d0ce; font-size: 12px; font-weight: 700; }
                        TouchArea { accessible-role: button; accessible-label: "Show " + label + " view"; clicked => { root.selected-view = index; root.selected-plan-date = ""; root.selected-plan-hour = -1; root.selected-plan-reminder = ""; root.selected-plan-event = ""; root.selected-plan-title = ""; root.selected-plan-time = ""; } }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.selected-view == 0: Rectangle { width: 28px; Text { width: parent.width; height: parent.height; text: "‹"; color: #c4d0ce; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.request-plan-week(-1); } } }
                    if root.selected-view == 0: Rectangle { width: 116px; Text { width: parent.width; height: parent.height; text: root.plan-week-title; color: #c4d0ce; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.request-plan-week(0); } } }
                    if root.selected-view == 0: Rectangle { width: 28px; Text { width: parent.width; height: parent.height; text: "›"; color: #c4d0ce; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.request-plan-week(1); } } }
                    if root.selected-view != 0: Rectangle { width: 80px; height: 28px; border-radius: 6px; background: #293436; Text { width: parent.width; height: parent.height; text: "Planned"; color: #829492; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
                }
                if root.selected-section != 5 : Rectangle { height: 1px; background: #344144; }
                if root.selected-section == 0 && root.selected-view == 0 : Rectangle { vertical-stretch: 1; border-radius: 8px; background: #1b2325; border-width: 1px; border-color: #344144;
                    ScrollView { width: parent.width; height: parent.height; viewport-width: self.width; viewport-height: 1566px; viewport-y <=> root.plan-scroll-y; horizontal-scrollbar-policy: ScrollBarPolicy.always-off; vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                    VerticalLayout { width: parent.width; height: 1566px; padding-left: 6px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px; spacing: 0;
                        HorizontalLayout { height: 58px; Text { width: 48px; } Rectangle { width: 6px; } for day in root.plan-week-days: Text { horizontal-stretch: 1; height: 32px; text: day.label; horizontal-alignment: center; vertical-alignment: center; color: day.today ? root.accent : day.weekend ? #d96d74 : #aab9b7; font-size: 11px; font-weight: day.today ? 700 : 400; } }
                        for hour[hour-index] in ["00:00", "01:00", "02:00", "03:00", "04:00", "05:00", "06:00", "07:00", "08:00", "09:00", "10:00", "11:00", "12:00", "13:00", "14:00", "15:00", "16:00", "17:00", "18:00", "19:00", "20:00", "21:00", "22:00", "23:00"]: HorizontalLayout { min-height: 60px; max-height: 60px; Text { width: 48px; text: hour; color: #829492; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; } Rectangle { width: 6px; } for day in root.plan-week-days: Rectangle { horizontal-stretch: 1; private property <bool> selected: root.selected-plan-date == day.date && root.selected-plan-hour == hour-index && root.selected-plan-reminder == "" && root.selected-plan-event == ""; background: self.selected ? #314043 : day.today ? #202a2c : transparent; border-width: self.selected ? 2px : 1px; border-color: self.selected ? root.accent : #293436; TouchArea { clicked => { if parent.selected { root.selected-plan-date = ""; root.selected-plan-hour = -1; root.selected-plan-time = ""; } else { root.selected-plan-date = day.date; root.selected-plan-hour = hour-index; root.selected-plan-time = hour; } root.selected-plan-reminder = ""; root.selected-plan-event = ""; root.selected-plan-title = ""; } double-clicked => { root.selected-plan-date = day.date; root.selected-plan-hour = hour-index; root.selected-plan-reminder = ""; root.selected-plan-event = ""; root.selected-plan-title = ""; root.selected-plan-time = hour; root.request-new-event(day.date, hour-index); root.editor-modal = 6; } } } }
                        Rectangle { min-height: 48px; max-height: 48px; }
                    }
                    for event in root.plan-all-day-events: Rectangle { private property <length> day-width: (parent.width - 76px) / 7; x: 62px + event.day-index * self.day-width; y: 42px; width: self.day-width - 4px; height: 20px; border-radius: 4px; background: root.selected-plan-event == event.id ? #edc77d : #b99655; clip: true; Text { x: 4px; width: parent.width - 8px; height: parent.height; text: event.title; color: #171d1f; font-size: 10px; font-weight: 700; vertical-alignment: center; overflow: elide; } TouchArea { accessible-role: button; accessible-label: event.title + ", all day"; clicked => { root.selected-plan-event = root.selected-plan-event == event.id ? "" : event.id; root.selected-plan-reminder = ""; root.selected-plan-hour = -1; root.selected-plan-date = root.selected-plan-event == "" ? "" : event.date; root.selected-plan-title = root.selected-plan-event == "" ? "" : event.title; root.selected-plan-time = root.selected-plan-event == "" ? "" : "All day"; } double-clicked => { root.selected-plan-event = event.id; root.request-edit-event(event.id); root.editor-modal = 6; } } }
                    if root.current-plan-day >= 0 && root.current-plan-minute >= 0: Rectangle { private property <length> day-width: (parent.width - 76px) / 7; x: 62px + root.current-plan-day * self.day-width; y: 68px + root.current-plan-minute * 1px; width: self.day-width - 4px; height: 2px; background: #d96d74; Text { x: -50px; y: -9px; width: 43px; height: 18px; text: root.current-plan-time; color: #d96d74; font-size: 11px; font-weight: 700; horizontal-alignment: right; vertical-alignment: center; } Rectangle { x: -3px; y: -2px; width: 6px; height: 6px; border-radius: 3px; background: #d96d74; } }
