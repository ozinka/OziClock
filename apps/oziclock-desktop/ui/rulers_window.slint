export struct RulerColumnData {
    accent: color,
}

export component RulersWindow inherits Window {
    title: "OziClock — Rulers";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    in property <[RulerColumnData]> rulers;
    in property <[int]> tick-indices;
    in property <[int]> label-hours;
    in property <int> focused-column: 0;
    in-out property <float> focus-column-position: 0;
    in property <float> focus-progress: 0;
    in property <float> clock-scale: 1.0;
    in-out property <bool> lens-dragging: false;
    in-out property <bool> focus-dragging: false;
    in-out property <length> focus-drag-anchor: 0px;
    in-out property <float> focus-column-raw-position: 0;
    pure callback format-label(int, int) -> string;
    callback request-focus-column(int);
    callback request-focus-progress(float);

    preferred-width: (100px * root.rulers.length + 1px) * root.clock-scale;
    preferred-height: 463px * root.clock-scale;
    min-width: 101px * root.clock-scale;
    min-height: 463px * root.clock-scale;
    max-height: 463px * root.clock-scale;

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #000000;
        clip: true;

        for ruler[index] in root.rulers: Rectangle {
            x: (1px + index * 100px) * root.clock-scale;
            width: 99px * root.clock-scale;
            height: parent.height;
            background: ruler.accent;

            for tick[tick-index] in root.tick-indices: Rectangle {
                x: 0px;
                y: (15px + tick * 3px) * root.clock-scale;
                width: (Math.mod(tick-index, 6) == 0 ? 25px : Math.mod(tick-index, 6) == 3 ? 20px : 15px) * root.clock-scale;
                height: 1px;
                background: #000000;
            }
            for tick[tick-index] in root.tick-indices: Rectangle {
                x: parent.width - (Math.mod(tick-index, 6) == 0 ? 25px : Math.mod(tick-index, 6) == 3 ? 20px : 15px) * root.clock-scale;
                y: (15px + tick * 3px) * root.clock-scale;
                width: (Math.mod(tick-index, 6) == 0 ? 25px : Math.mod(tick-index, 6) == 3 ? 20px : 15px) * root.clock-scale;
                height: 1px;
                background: #000000;
            }
            for hour[hour-index] in root.label-hours: Text {
                x: 0px;
                y: (6px + hour-index * 18px) * root.clock-scale;
                width: parent.width;
                height: 18px * root.clock-scale;
                text: root.format-label(index, hour);
                color: #000000;
                font-family: "Carlito";
                font-size: 12px * root.clock-scale;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: top;
            }
            TouchArea { clicked => { root.request-focus-column(index); } }
        }

        Rectangle { x: 0px; y: 0px; width: root.focus-column-position * 100px * root.clock-scale; height: root.focus-progress * 433px * root.clock-scale; background: #00000090; }
        Rectangle { x: (root.focus-column-position + 1) * 100px * root.clock-scale; y: 0px; width: parent.width; height: root.focus-progress * 433px * root.clock-scale; background: #00000090; }
        Rectangle { x: 0px; y: root.focus-progress * 433px * root.clock-scale + 30px * root.clock-scale; width: root.focus-column-position * 100px * root.clock-scale; height: parent.height; background: #00000090; }
        Rectangle { x: (root.focus-column-position + 1) * 100px * root.clock-scale; y: root.focus-progress * 433px * root.clock-scale + 30px * root.clock-scale; width: parent.width; height: parent.height; background: #00000090; }
        Rectangle { x: root.focus-column-position * 100px * root.clock-scale; y: 0px; width: 2px * root.clock-scale; height: parent.height; background: #800000; }
        Rectangle { x: (root.focus-column-position + 1) * 100px * root.clock-scale - 2px * root.clock-scale; y: 0px; width: 2px * root.clock-scale; height: parent.height; background: #800000; }
        lens := Rectangle {
            x: 0px;
            y: root.focus-progress * 433px * root.clock-scale;
            width: parent.width;
            height: 30px * root.clock-scale;
            clip: true;
            property <length> source-center: Math.max(15px * root.clock-scale, Math.min(447px * root.clock-scale, root.focus-progress * 433px * root.clock-scale + 15px * root.clock-scale));

            for ruler[index] in root.rulers: Rectangle {
                x: (1px + index * 100px) * root.clock-scale;
                width: 99px * root.clock-scale;
                height: parent.height;
                background: ruler.accent;

                for tick[tick-index] in root.tick-indices: Rectangle {
                    x: 0px;
                    y: Math.round((((15px + tick * 3px) * root.clock-scale - lens.source-center) * 1.6 + 15px * root.clock-scale) / 1px) * 1px;
                    width: (Math.mod(tick-index, 6) == 0 ? 25px : Math.mod(tick-index, 6) == 3 ? 20px : 15px) * root.clock-scale;
                    height: 2px;
                    background: #000000;
                }
                for tick[tick-index] in root.tick-indices: Rectangle {
                    x: parent.width - (Math.mod(tick-index, 6) == 0 ? 25px : Math.mod(tick-index, 6) == 3 ? 20px : 15px) * root.clock-scale;
                    y: Math.round((((15px + tick * 3px) * root.clock-scale - lens.source-center) * 1.6 + 15px * root.clock-scale) / 1px) * 1px;
                    width: (Math.mod(tick-index, 6) == 0 ? 25px : Math.mod(tick-index, 6) == 3 ? 20px : 15px) * root.clock-scale;
                    height: 2px;
                    background: #000000;
                }
                for hour[hour-index] in root.label-hours: Text {
                    x: 0px;
                    y: ((6px + hour-index * 18px) * root.clock-scale + 9px * root.clock-scale - lens.source-center) * 1.6 + 0.6px * root.clock-scale;
                    width: parent.width;
                    height: 28.8px * root.clock-scale;
                    text: root.format-label(index, hour);
                    color: #000000;
                    font-family: "Carlito";
                    font-size: 12px * root.clock-scale * 1.6;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                width: parent.width;
                height: parent.height;
                background: @linear-gradient(180deg, #00000088, #00000055 10%, #00000000 40%, #00000000 60%, #00000055 90%, #00000088);
            }
            Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: #111111; }
            Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: #111111; }
        }
        TouchArea {
            x: root.focus-column-position * 100px * root.clock-scale;
            y: 0px;
            width: 100px * root.clock-scale;
            height: parent.height;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.focus-dragging = true;
                    root.focus-drag-anchor = self.mouse-x;
                    root.request-focus-column(Math.round(root.focus-column-position));
                }
                if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) { root.focus-dragging = false; }
            }
            moved => {
                if (root.focus-dragging) {
                    root.focus-column-raw-position = Math.max(0, Math.min(root.rulers.length - 1, (self.mouse-x - root.focus-drag-anchor + root.focus-column-position * 100px * root.clock-scale) / (100px * root.clock-scale)));
                    root.focus-column-position = root.focus-column-raw-position - Math.round(root.focus-column-raw-position) < 0.05 && root.focus-column-raw-position - Math.round(root.focus-column-raw-position) > -0.05 ? Math.round(root.focus-column-raw-position) : root.focus-column-raw-position;
                    root.request-focus-column(Math.round(root.focus-column-position));
                }
            }
        }
        TouchArea {
            x: lens.x;
            y: lens.y;
            width: lens.width;
            height: lens.height;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.lens-dragging = true;
                    root.request-focus-progress(Math.max(0, Math.min(1, ((lens.y + self.mouse-y) / root.clock-scale - 15px) / 433px)));
                }
                if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) { root.lens-dragging = false; }
            }
            moved => { if (root.lens-dragging) { root.request-focus-progress(Math.max(0, Math.min(1, ((lens.y + self.mouse-y) / root.clock-scale - 15px) / 433px))); } }
        }
    }
}
