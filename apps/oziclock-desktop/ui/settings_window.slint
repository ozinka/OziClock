import { AppPalette } from "../../../ui/app_palette.slint";
import { CheckBox } from "std-widgets.slint";
import { ClockTile } from "../../../ui/clock_tile.slint";
import { DeleteIcon } from "delete_icon.slint";

export struct ClockListItem {
    label: string,
    time-zone: string,
    accent: color,
    is-main: bool,
}

export component SettingsWindow inherits Window {
    title: "OziClock — Settings";
    no-frame: true;
    always-on-top: true;
    preferred-width: root.saved-window-width * 1px;
    preferred-height: root.saved-window-height * 1px;
    min-width: 710px;
    min-height: 672px;
    max-width: 710px;
    background: transparent;

    in property <[ClockListItem]> clocks;
    in property <[string]> time-zones;
    in property <[string]> time-zone-ids;
    in-out property <int> selected-index: -1;
    in-out property <int> selected-section: 0;
    in-out property <string> editor-label;
    in-out property <string> editor-time-zone;
    in-out property <int> selected-time-zone-index: -1;
    in-out property <string> time-zone-search;
    in-out property <string> time-zone-search-message;
    out property <bool> time-zone-search-focused: time-zone-search-input.has-focus;
    out property <bool> time-zone-picker-focused: time-zone-picker.has-focus;
    in-out property <string> editor-color;
    in-out property <bool> editor-is-main;
    in-out property <bool> show-seconds;
    in-out property <bool> top-most;
    in-out property <bool> show-in-task-bar;
    in-out property <bool> launch-at-login;
    in-out property <float> opacity-percent;
    in-out property <bool> compact-mode;
    in-out property <float> clock-scale-percent: 100;
    in-out property <float> corner-radius: 12;
    in-out property <bool> soft-clock-style: false;
    in-out property <string> border-color-value: "#000000";
    in-out property <color> border-preview-color: #000000;
    in-out property <float> non-main-dimming: 0;
    in property <bool> application-light-theme: true;
    callback request-set-application-light-theme(bool);
    callback application-theme-changed();
    in-out property <bool> calendar-monday-first: true;
    in-out property <int> calendar-hour-range: 0;
    in-out property <bool> calendar-show-events: true;
    in-out property <bool> calendar-show-reminders: true;
    in-out property <bool> calendar-show-tasks: true;
    in-out property <bool> calendar-show-alarms: true;
    in-out property <int> alert-sound-duration-seconds: 20;
    in-out property <string> sync-directory;
    in-out property <bool> sync-planner: true;
    in-out property <bool> sync-clocks: true;
    in-out property <bool> sync-appearance: true;
    in-out property <int> sync-preview-action: 0;
    in-out property <bool> sync-status-is-error: false;
    in-out property <bool> sync-status-visible: false;
    in-out property <bool> planner-follow-main-clock: true;
    in-out property <bool> planner-use-accent-color: true;
    in property <[string]> planner-colors;
    in property <[color]> planner-color-previews;
    callback request-planner-option(int, bool);
    callback request-planner-color(int, string);
    in-out property <string> status-message;
    in-out property <bool> color-picker-open: false;
    in-out property <string> picker-color-value;
    in-out property <float> picker-hue: 220;
    in-out property <float> picker-saturation: 70;
    in-out property <float> picker-value: 90;
    in-out property <color> picker-hue-color: AppPalette.primary;
    in-out property <color> editor-preview-color: #ffffff;
    in-out property <int> dragging-index: -1;
    in-out property <float> dragging-offset: 0;
    in-out property <bool> remove-confirmation-open: false;
    in-out property <string> remove-confirmation-label;
    in-out property <float> saved-window-width: 710;
    in-out property <float> saved-window-height: 672;
    in property <bool> vertical-resize-handles: false;
    callback request-vertical-resize(bool);
    callback request-close();
    callback request-window-drag();
    callback request-select(int);
    callback request-select-general();
    callback request-select-calendar();
    callback request-select-planner();
    callback request-select-sync();
    callback request-configure-sync();
    callback request-preview-sync-send();
    callback request-preview-sync-receive();
    callback request-send-sync();
    callback request-receive-sync();
    callback request-add();
    callback request-remove(int);
    callback request-confirm-remove();
    callback request-cancel-remove();
    callback request-save();
    callback request-apply();
    callback request-move-up();
    callback request-move-down();
    callback request-drag-clock(int, float);
    callback request-list-press(float, float);
    callback request-drag-end();
    callback request-open-color-picker();
    callback request-open-border-color-picker();
    callback request-open-planner-color-picker(int);
    callback request-pick-color(string);
    callback request-picker-color(float, float);
    callback request-picker-hue(float);
    callback request-select-time-zone(int);
    callback request-filter-time-zones(string);
    callback request-color-confirm();
    callback request-color-cancel();
    callback request-set-show-seconds(bool);
    callback request-set-top-most(bool);
    callback request-set-show-in-task-bar(bool);
    callback request-set-launch-at-login(bool);
    callback request-set-opacity(float);
    callback request-set-compact-mode(bool);
    callback request-set-clock-scale(float);
    callback request-set-corner-radius(float);
    callback request-set-soft-clock-style(bool);
    callback request-set-border-color(string);
    callback request-set-non-main-dimming(float);
    callback request-set-calendar-monday-first(bool);
    callback request-set-calendar-hour-range(int);
    callback request-set-calendar-indicator-filter(int, bool);
    callback request-set-alert-sound-duration-seconds(int);

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: AppPalette.surface;
        border-radius: root.corner-radius * 1px;
        clip: true;
        border-width: 1px;
        border-color: AppPalette.border;

        Text { x: 28px; y: 22px; text: "OZI CLOCK"; color: AppPalette.heading; font-family: "Carlito"; font-size: 18px; font-weight: 700; }
        Text { x: 28px; y: 49px; text: "Clock settings"; color: AppPalette.muted; font-family: "Carlito"; font-size: 13px; }
        TouchArea { x: 0px; y: 0px; width: 690px; height: 82px; pointer-event(event) => { if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) { root.request-window-drag(); } } }
        ClockTile { x: parent.width - 127px; y: 94px; width: 99px; height: 60px; visible: root.selected-section == 1; label: root.editor-label; month: "08/"; day: "24"; hour: "12"; minute: "34"; second: "56"; accent: root.editor-preview-color; main-zone: root.editor-is-main; soft-style: root.soft-clock-style; }
        Rectangle { x: 0px; y: 82px; width: 260px; height: parent.height - 82px; background: AppPalette.sidebar; }
        Rectangle { x: 14px; y: 95px; width: 232px; height: 37px; border-radius: 6px; background: root.selected-section == 0 ? AppPalette.selected : AppPalette.sidebar; Text { x: 10px; y: 9px; text: "General"; color: AppPalette.text; font-family: "Carlito"; font-size: 14px; } TouchArea { clicked => { root.request-select-general(); } } }
        Rectangle { x: 14px; y: 138px; width: 232px; height: 37px; border-radius: 6px; background: root.selected-section == 2 ? AppPalette.selected : AppPalette.sidebar; Text { x: 10px; y: 9px; text: "Calendar"; color: AppPalette.text; font-family: "Carlito"; font-size: 14px; } TouchArea { clicked => { root.request-select-calendar(); } } }
        Rectangle { x: 14px; y: 181px; width: 232px; height: 37px; border-radius: 6px; background: root.selected-section == 3 ? AppPalette.selected : AppPalette.sidebar; Text { x: 10px; y: 9px; text: "Planner"; color: AppPalette.text; font-family: "Carlito"; font-size: 14px; } TouchArea { clicked => { root.request-select-planner(); } } }
        Rectangle { x: 14px; y: 224px; width: 232px; height: 37px; border-radius: 6px; background: root.selected-section == 4 ? AppPalette.selected : AppPalette.sidebar; Text { x: 10px; y: 9px; text: "Sync"; color: AppPalette.text; font-family: "Carlito"; font-size: 14px; } TouchArea { clicked => { root.request-select-sync(); } } }
        Rectangle { x: 28px; y: 275px; width: 204px; height: 1px; background: AppPalette.border; }

        Rectangle {
            x: 14px;
            y: 289px;
            width: 232px;
            height: 37px;
            border-radius: 6px;
            background: AppPalette.sidebar;
            Text { x: 10px; y: 8px; text: "+ Add clock"; color: AppPalette.link; font-family: "Carlito"; font-size: 14px; }
            TouchArea { clicked => { root.request-add(); } }
        }
        clock-list-scroll := ScrollView {
            x: 0px;
            y: 334px;
            width: 260px;
            height: parent.height - 334px;
            viewport-width: 260px;
            viewport-height: root.clocks.length * 43px;
            vertical-scrollbar-policy: ScrollBarPolicy.always-on;
        for clock[index] in root.clocks: Rectangle {
            x: 14px;
            y: index * 43px + (index == root.dragging-index ? root.dragging-offset * 1px : 0px);
            animate y { duration: index == root.dragging-index ? 0ms : 80ms; easing: ease-in-out; }
            width: 232px;
            height: 37px;
            border-radius: 6px;
            background: root.selected-section == 1 && index == root.selected-index ? AppPalette.selected : AppPalette.sidebar;
            Text { x: 10px; y: 10px; width: 12px; height: 17px; text: "⠿"; color: AppPalette.muted; font-size: 16px; vertical-alignment: center; }
            Rectangle { x: 30px; y: 9px; width: 18px; height: 18px; border-radius: 5px; background: clock.accent; }
            Text { x: 57px; y: 8px; width: 45px; height: 21px; text: clock.label; color: clock.is-main ? AppPalette.emphasized-text : AppPalette.text; font-family: "Carlito"; font-size: 14px; font-weight: clock.is-main ? 700 : 500; vertical-alignment: center; }
            Text { x: 104px; y: 8px; width: 100px; height: 21px; text: clock.time-zone; color: AppPalette.muted; font-family: "Carlito"; font-size: 11px; overflow: elide; vertical-alignment: center; }
            DeleteIcon { x: 214px; y: 7px; }
        }
        TouchArea {
            x: 0px; y: 0px; width: 260px; height: root.clocks.length * 43px;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) { root.request-list-press(self.mouse-x / 1px, self.mouse-y / 1px); }
                if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) { root.request-drag-end(); }
            }
            moved => { root.request-drag-clock(root.dragging-index, self.mouse-y / 1px); }
        }
        }
        Rectangle {
            x: 14px;
            y: 334px + root.dragging-index * 43px - clock-list-scroll.viewport-y + root.dragging-offset * 1px;
            width: 232px;
            height: 37px;
            visible: root.dragging-index >= 0 && root.dragging-index < root.clocks.length;
            border-radius: 6px;
            background: AppPalette.selected;
            Text { x: 10px; y: 10px; width: 12px; height: 17px; text: "⠿"; color: AppPalette.muted; font-size: 16px; vertical-alignment: center; }
            Rectangle { x: 30px; y: 9px; width: 18px; height: 18px; border-radius: 5px; background: root.clocks[root.dragging-index].accent; }
            Text { x: 57px; y: 8px; width: 45px; height: 21px; text: root.clocks[root.dragging-index].label; color: root.clocks[root.dragging-index].is-main ? AppPalette.emphasized-text : AppPalette.text; font-family: "Carlito"; font-size: 14px; font-weight: root.clocks[root.dragging-index].is-main ? 700 : 500; vertical-alignment: center; }
            Text { x: 104px; y: 8px; width: 100px; height: 21px; text: root.clocks[root.dragging-index].time-zone; color: AppPalette.muted; font-family: "Carlito"; font-size: 11px; overflow: elide; vertical-alignment: center; }
            Rectangle { x: 214px; y: 9px; width: 14px; height: 2px; border-radius: 1px; background: AppPalette.danger; }
            Rectangle { x: 218px; y: 7px; width: 6px; height: 2px; border-radius: 1px; background: AppPalette.danger; }
            Rectangle { x: 216px; y: 12px; width: 10px; height: 13px; border-radius: 1px; border-width: 1px; border-color: AppPalette.danger; background: transparent; }
        }

        Rectangle { x: 286px; y: 82px; width: parent.width - 314px; height: 1px; background: AppPalette.border; }
        Text { x: 286px; y: 107px; text: root.selected-section == 0 ? "General" : (root.selected-section == 2 ? "Calendar" : (root.selected-section == 3 ? "Planner" : (root.selected-section == 4 ? "Sync" : "Edit clock"))); color: AppPalette.heading; font-family: "Carlito"; font-size: 21px; font-weight: 700; }
        Text { x: 286px; y: 139px; visible: root.selected-section == 1; text: root.status-message; color: AppPalette.muted; font-family: "Carlito"; font-size: 13px; }
        Text { x: 286px; y: 185px; visible: root.selected-section == 1; text: "Name"; color: AppPalette.secondary; font-family: "Carlito"; font-size: 12px; font-weight: 600; }

        Rectangle {
            x: 286px; y: 207px; visible: root.selected-section == 1; width: 243px; height: 42px; border-radius: 6px; background: transparent;
            LineEdit { x: 0px; y: 0px; width: parent.width; height: parent.height; text <=> root.editor-label; edited(value) => { root.editor-label = value; root.request-apply(); } }
        }
        Text { x: 286px; y: 275px; visible: root.selected-section == 1; text: "Time zone"; color: AppPalette.secondary; font-family: "Carlito"; font-size: 12px; font-weight: 600; }
        Rectangle {
            x: 286px; y: 297px; visible: root.selected-section == 1; width: 390px; height: 42px; border-radius: 6px; background: transparent;
            time-zone-search-input := LineEdit {
                width: parent.width; height: parent.height;
                placeholder-text: "Search by city, region, or UTC offset";
                text <=> root.time-zone-search;
                edited(value) => { root.request-filter-time-zones(value); }
            }
        }
        time-zone-picker := ComboBox { x: 286px; y: 347px; visible: root.selected-section == 1; width: 390px; height: 42px; model: root.time-zones; current-index <=> root.selected-time-zone-index; selected => { root.request-select-time-zone(self.current-index); } }
        Text { x: 286px; y: 393px; visible: root.selected-section == 1 && root.time-zone-search-message != ""; text: root.time-zone-search-message; color: AppPalette.muted; font-family: "Carlito"; font-size: 13px; }
        Text { x: 539px; y: 185px; visible: root.selected-section == 1; text: "Color"; color: AppPalette.secondary; font-family: "Carlito"; font-size: 12px; font-weight: 600; }
        Rectangle { x: 539px; y: 207px; visible: root.selected-section == 1; width: 88px; height: 42px; border-radius: 6px; background: transparent; LineEdit { x: 0px; y: 0px; width: parent.width; height: parent.height; text <=> root.editor-color; edited => { root.request-apply(); } } }
        Rectangle { x: 635px; y: 207px; visible: root.selected-section == 1; width: 42px; height: 42px; border-radius: 6px; border-width: 1px; border-color: AppPalette.disabled; background: root.editor-preview-color; TouchArea { clicked => { root.request-open-color-picker(); } } }
        Rectangle { x: 286px; y: 432px; width: 22px; height: 22px; visible: root.selected-section == 1 && !root.color-picker-open; border-radius: 5px; background: root.editor-is-main ? AppPalette.primary : AppPalette.inset; Text { width: parent.width; height: parent.height; text: root.editor-is-main ? "✓" : ""; color: white; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.editor-is-main = !root.editor-is-main; root.request-apply(); } } }
        Text { x: 318px; y: 434px; visible: root.selected-section == 1 && !root.color-picker-open; text: "Primary clock"; color: AppPalette.text; font-family: "Carlito"; font-size: 13px; }
        Rectangle { x: 286px; y: 145px; width: 22px; height: 22px; visible: root.selected-section == 0; border-radius: 5px; background: root.top-most ? AppPalette.primary : AppPalette.inset; Text { width: parent.width; height: parent.height; text: root.top-most ? "✓" : ""; color: white; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.top-most = !root.top-most; root.request-set-top-most(root.top-most); } } }
        Text { x: 318px; y: 147px; visible: root.selected-section == 0; text: "Always on top"; color: AppPalette.text; font-family: "Carlito"; font-size: 13px; }
        Rectangle { x: 286px; y: 179px; width: 22px; height: 22px; visible: root.selected-section == 0; border-radius: 5px; background: root.show-seconds ? AppPalette.primary : AppPalette.inset; Text { width: parent.width; height: parent.height; text: root.show-seconds ? "✓" : ""; color: white; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.show-seconds = !root.show-seconds; root.request-set-show-seconds(root.show-seconds); } } }
        Text { x: 318px; y: 181px; visible: root.selected-section == 0; text: "Show seconds"; color: AppPalette.text; font-family: "Carlito"; font-size: 13px; }
        Rectangle { x: 286px; y: 213px; width: 22px; height: 22px; visible: root.selected-section == 0; border-radius: 5px; background: root.compact-mode ? AppPalette.primary : AppPalette.inset; Text { width: parent.width; height: parent.height; text: root.compact-mode ? "✓" : ""; color: white; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.compact-mode = !root.compact-mode; root.request-set-compact-mode(root.compact-mode); } } }
        Text { x: 318px; y: 215px; visible: root.selected-section == 0; text: "Compact mode"; color: AppPalette.text; font-family: "Carlito"; font-size: 13px; }
        Rectangle { x: 510px; y: 213px; width: 22px; height: 22px; visible: root.selected-section == 0; border-radius: 5px; background: root.show-in-task-bar ? AppPalette.primary : AppPalette.inset; Text { width: parent.width; height: parent.height; text: root.show-in-task-bar ? "✓" : ""; color: white; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.show-in-task-bar = !root.show-in-task-bar; root.request-set-show-in-task-bar(root.show-in-task-bar); } } }
        Text { x: 542px; y: 215px; visible: root.selected-section == 0; text: "Show in taskbar"; color: AppPalette.text; font-family: "Carlito"; font-size: 13px; }
        Rectangle { x: 510px; y: 145px; width: 22px; height: 22px; visible: root.selected-section == 0; border-radius: 5px; background: root.soft-clock-style ? AppPalette.primary : AppPalette.inset; Text { width: parent.width; height: parent.height; text: root.soft-clock-style ? "✓" : ""; color: white; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.soft-clock-style = !root.soft-clock-style; root.request-set-soft-clock-style(root.soft-clock-style); } } }
        Text { x: 542px; y: 147px; visible: root.selected-section == 0; text: "Soft color style"; color: AppPalette.text; font-family: "Carlito"; font-size: 13px; }
        Rectangle { x: 510px; y: 179px; width: 22px; height: 22px; visible: root.selected-section == 0; border-radius: 5px; background: root.launch-at-login ? AppPalette.primary : AppPalette.inset; Text { width: parent.width; height: parent.height; text: root.launch-at-login ? "✓" : ""; color: white; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.launch-at-login = !root.launch-at-login; root.request-set-launch-at-login(root.launch-at-login); } } }
        Text { x: 542px; y: 181px; visible: root.selected-section == 0; text: "Launch at login"; color: AppPalette.text; font-family: "Carlito"; font-size: 13px; }
        Text { x: 286px; y: 259px; visible: root.selected-section == 0; text: "Opacity"; color: AppPalette.secondary; font-family: "Carlito"; font-size: 12px; font-weight: 600; }
        Slider { x: 276px; y: 279px; width: 320px; height: 24px; visible: root.selected-section == 0; minimum: 2; maximum: 100; step: 1; value <=> root.opacity-percent; changed => { root.request-set-opacity(self.value); } }
        Text { x: 612px; y: 278px; width: 64px; height: 24px; visible: root.selected-section == 0; text: Math.round(root.opacity-percent) + "%"; color: AppPalette.text; font-family: "Carlito"; font-size: 13px; horizontal-alignment: right; vertical-alignment: center; }
        Text { x: 286px; y: 313px; visible: root.selected-section == 0; text: "Clock scale"; color: AppPalette.secondary; font-family: "Carlito"; font-size: 12px; font-weight: 600; }
        Slider { x: 276px; y: 333px; width: 320px; height: 24px; visible: root.selected-section == 0; minimum: 80; maximum: 150; step: 5; value <=> root.clock-scale-percent; changed => { root.request-set-clock-scale(self.value); } }
        Text { x: 612px; y: 332px; width: 64px; height: 24px; visible: root.selected-section == 0; text: Math.round(root.clock-scale-percent) + "%"; color: AppPalette.text; font-family: "Carlito"; font-size: 13px; horizontal-alignment: right; vertical-alignment: center; }
        Text { x: 286px; y: 367px; visible: root.selected-section == 0; text: "Corner radius"; color: AppPalette.secondary; font-family: "Carlito"; font-size: 12px; font-weight: 600; }
        Slider { x: 276px; y: 387px; width: 320px; height: 24px; visible: root.selected-section == 0; minimum: 0; maximum: 15.5; step: 0.5; value <=> root.corner-radius; changed => { root.request-set-corner-radius(self.value); } }
        Text { x: 612px; y: 386px; width: 64px; height: 24px; visible: root.selected-section == 0; text: Math.round(root.corner-radius) + " px"; color: AppPalette.text; font-family: "Carlito"; font-size: 13px; horizontal-alignment: right; vertical-alignment: center; }
        Text { x: 286px; y: 421px; visible: root.selected-section == 0; text: "Dim non-primary clocks"; color: AppPalette.secondary; font-family: "Carlito"; font-size: 12px; font-weight: 600; }
        Slider { x: 276px; y: 441px; width: 320px; height: 24px; visible: root.selected-section == 0; minimum: 0; maximum: 80; step: 5; value <=> root.non-main-dimming; changed => { root.request-set-non-main-dimming(self.value); } }
        Text { x: 612px; y: 440px; width: 64px; height: 24px; visible: root.selected-section == 0; text: Math.round(root.non-main-dimming) + "%"; color: AppPalette.text; font-family: "Carlito"; font-size: 13px; horizontal-alignment: right; vertical-alignment: center; }
        Text { x: 286px; y: 474px; visible: root.selected-section == 0; text: "Border and separator color"; color: AppPalette.secondary; font-family: "Carlito"; font-size: 12px; font-weight: 600; }
        Rectangle { x: 286px; y: 494px; visible: root.selected-section == 0; width: 190px; height: 38px; border-radius: 6px; background: transparent; LineEdit { width: parent.width; height: parent.height; text <=> root.border-color-value; edited => { root.request-set-border-color(root.border-color-value); } } }
        Rectangle { x: 488px; y: 492px; visible: root.selected-section == 0; width: 42px; height: 42px; border-radius: 6px; border-width: 1px; border-color: AppPalette.disabled; background: root.border-preview-color; TouchArea { clicked => { root.request-open-border-color-picker(); } } }
        Text { x: 286px; y: 151px; visible: root.selected-section == 4; text: "Sync profile folder"; color: AppPalette.secondary; font-family: "Carlito"; font-size: 12px; font-weight: 600; }
        LineEdit { x: 286px; y: 173px; visible: root.selected-section == 4; width: 390px; height: 38px; text <=> root.sync-directory; placeholder-text: "Paste a Google Drive, OneDrive, or Dropbox folder"; }
        CheckBox { x: 286px; y: 225px; visible: root.selected-section == 4; text: "Planner data"; checked <=> root.sync-planner; }
        CheckBox { x: 426px; y: 225px; visible: root.selected-section == 4; text: "Clocks"; checked <=> root.sync-clocks; }
        CheckBox { x: 526px; y: 225px; visible: root.selected-section == 4; text: "Appearance"; checked <=> root.sync-appearance; }
        Rectangle { x: 286px; y: 269px; visible: root.selected-section == 4; width: 164px; height: 38px; border-radius: 6px; background: AppPalette.primary; Text { width: parent.width; height: parent.height; text: "Save sync profile"; color: white; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; TouchArea { clicked => { root.request-configure-sync(); } } } }
        Rectangle { x: 462px; y: 269px; visible: root.selected-section == 4; width: 102px; height: 38px; border-radius: 6px; background: AppPalette.selected; Text { width: parent.width; height: parent.height; text: "Preview send"; color: AppPalette.text; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; TouchArea { clicked => { root.request-preview-sync-send(); } } } }
        Rectangle { x: 574px; y: 269px; visible: root.selected-section == 4; width: 102px; height: 38px; border-radius: 6px; background: AppPalette.selected; Text { width: parent.width; height: parent.height; text: "Preview receive"; color: AppPalette.text; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; TouchArea { clicked => { root.request-preview-sync-receive(); } } } }
        Text { x: 286px; y: 321px; visible: root.selected-section == 4 && root.sync-status-visible; width: 390px; height: 48px; text: root.status-message; color: root.sync-status-is-error ? AppPalette.danger : AppPalette.success; font-family: "Carlito"; font-size: 12px; wrap: word-wrap; }
        Rectangle { x: 286px; y: 379px; visible: root.selected-section == 4 && root.sync-preview-action == 1; width: 132px; height: 38px; border-radius: 6px; background: AppPalette.primary; Text { width: parent.width; height: parent.height; text: "Send now"; color: white; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; TouchArea { clicked => { root.request-send-sync(); } } } }
        Rectangle { x: 286px; y: 379px; visible: root.selected-section == 4 && root.sync-preview-action == 2; width: 132px; height: 38px; border-radius: 6px; background: AppPalette.primary; Text { width: parent.width; height: parent.height; text: "Receive now"; color: white; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; TouchArea { clicked => { root.request-receive-sync(); } } } }
        Text { x: 286px; y: 558px; visible: root.selected-section == 0; text: "Application theme"; color: AppPalette.secondary; font-family: "Carlito"; font-size: 13px; }
        ComboBox { x: 426px; y: 548px; visible: root.selected-section == 0; width: 250px; height: 38px; model: ["Light", "Dark"]; current-index: root.application-light-theme ? 0 : 1; selected => { root.request-set-application-light-theme(self.current-index == 0); } }
        if root.selected-section == 3: Rectangle {
            x: 286px; y: 145px; width: 390px; height: 402px;
            Text { x: 0px; y: 0px; width: 128px; height: 32px; text: "Accent source"; color: AppPalette.secondary; font-size: 13px; vertical-alignment: center; }
            ComboBox { x: 140px; y: 0px; width: 250px; height: 32px; model: ["Main clock", "Custom"]; current-index: root.planner-follow-main-clock ? 0 : 1; selected => { root.request-planner-option(1, self.current-index == 0); } }
            CheckBox { x: 0px; y: 84px; width: 390px; height: 30px; text: "Use accent color"; checked: root.planner-use-accent-color; toggled => { root.request-planner-option(2, self.checked); } }
            for label[index] in ["Custom accent", "Alarms", "Timers", "Reminders", "Events", "Tasks"]: Rectangle {
                x: 0px; y: index == 0 ? 40px : 86px + index * 37px; width: 390px; height: 32px;
                private property <bool> editable: index == 0 ? !root.planner-follow-main-clock : !root.planner-use-accent-color;
                Text { x: 0px; y: 0px; width: 128px; height: parent.height; font-size: 13px; text: label; color: parent.editable ? AppPalette.secondary : AppPalette.disabled; vertical-alignment: center; }
                LineEdit { x: 140px; y: 0px; width: 208px; height: parent.height; enabled: parent.editable; text: root.planner-colors[index]; edited => { root.request-planner-color(index, self.text); } }
                Rectangle { x: 358px; y: 0px; width: 32px; height: 32px; border-radius: 5px; background: root.planner-color-previews[index]; border-width: 1px; border-color: AppPalette.disabled; TouchArea { enabled: index == 0 ? !root.planner-follow-main-clock : !root.planner-use-accent-color; accessible-role: button; accessible-label: "Choose " + label + " color"; clicked => { root.request-open-planner-color-picker(index); } } }
            }
            Text { x: 0px; y: 342px; width: 390px; height: 20px; text: "Click a swatch or enter #RRGGBB to choose a color."; color: AppPalette.muted; font-size: 12px; }
        }
        Text { x: 286px; y: 593px; width: 390px; visible: root.selected-section == 3; text: root.status-message; color: AppPalette.danger; font-size: 12px; overflow: elide; }
        Text { x: 286px; y: 566px; visible: root.selected-section == 3; text: "Alert sound"; color: AppPalette.secondary; font-size: 13px; }
        ComboBox { x: 426px; y: 558px; visible: root.selected-section == 3; width: 250px; height: 32px; model: ["Off", "1 second", "5 seconds", "10 seconds", "20 seconds", "30 seconds"]; current-index: root.alert-sound-duration-seconds == 0 ? 0 : (root.alert-sound-duration-seconds == 1 ? 1 : (root.alert-sound-duration-seconds == 5 ? 2 : (root.alert-sound-duration-seconds == 10 ? 3 : (root.alert-sound-duration-seconds == 20 ? 4 : 5)))); selected => { root.alert-sound-duration-seconds = self.current-index == 0 ? 0 : (self.current-index == 1 ? 1 : (self.current-index == 2 ? 5 : (self.current-index == 3 ? 10 : (self.current-index == 4 ? 20 : 30)))); root.request-set-alert-sound-duration-seconds(root.alert-sound-duration-seconds); } }
        Text { x: 286px; y: 151px; visible: root.selected-section == 2; text: "First day of week"; color: AppPalette.secondary; font-family: "Carlito"; font-size: 12px; font-weight: 600; }
        ComboBox { x: 286px; y: 173px; visible: root.selected-section == 2; width: 240px; height: 40px; model: ["Monday", "Sunday"]; current-index: root.calendar-monday-first ? 0 : 1; selected => { root.calendar-monday-first = self.current-index == 0; root.request-set-calendar-monday-first(root.calendar-monday-first); } }
        Text { x: 286px; y: 237px; visible: root.selected-section == 2; text: "Week view"; color: AppPalette.secondary; font-family: "Carlito"; font-size: 12px; font-weight: 600; }
        Text { x: 286px; y: 259px; visible: root.selected-section == 2; text: "Fixed 12-hour viewport · continuous day-by-day scrolling"; color: AppPalette.text; font-family: "Carlito"; font-size: 13px; }
        Text { x: 286px; y: 309px; visible: root.selected-section == 2; text: "Calendar indicators"; color: AppPalette.secondary; font-family: "Carlito"; font-size: 12px; font-weight: 600; }
        CheckBox { x: 286px; y: 331px; visible: root.selected-section == 2; text: "Events"; checked <=> root.calendar-show-events; toggled => { root.request-set-calendar-indicator-filter(0, self.checked); } }
        CheckBox { x: 396px; y: 331px; visible: root.selected-section == 2; text: "Reminders"; checked <=> root.calendar-show-reminders; toggled => { root.request-set-calendar-indicator-filter(1, self.checked); } }
        CheckBox { x: 526px; y: 331px; visible: root.selected-section == 2; text: "Tasks"; checked <=> root.calendar-show-tasks; toggled => { root.request-set-calendar-indicator-filter(2, self.checked); } }
        CheckBox { x: 286px; y: 363px; visible: root.selected-section == 2; text: "Alarms"; checked <=> root.calendar-show-alarms; toggled => { root.request-set-calendar-indicator-filter(3, self.checked); } }
        Rectangle {
            x: parent.width - 130px; y: parent.height - 58px; width: 102px; height: 42px; border-radius: 6px; background: AppPalette.primary;
            Text { width: parent.width; height: parent.height; text: "OK"; color: #ffffff; font-family: "Carlito"; font-size: 14px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; TouchArea { clicked => { root.request-save(); } } }
        }
        Text {
            x: parent.width - 58px; y: 22px; width: 30px; height: 30px; text: "×"; color: AppPalette.secondary; font-family: "Carlito"; font-size: 24px; horizontal-alignment: center; vertical-alignment: center;
            TouchArea { clicked => { root.request-close(); } }
        }
        Rectangle {
            x: 278px; y: 165px; width: 414px; height: 330px; visible: root.color-picker-open; border-radius: root.corner-radius * 1px; border-width: 1px; border-color: AppPalette.border; background: AppPalette.card;
            Text { x: 18px; y: 14px; text: "Choose color"; color: AppPalette.heading; font-size: 16px; font-weight: 700; }
            Rectangle { x: 18px; y: 50px; width: 378px; height: 180px; background: root.picker-hue-color;
                Rectangle { width: parent.width; height: parent.height; background: @linear-gradient(90deg, #ffffffff, #ffffff00); }
                Rectangle { width: parent.width; height: parent.height; background: @linear-gradient(180deg, #00000000, #000000ff); }
                Rectangle { x: root.picker-saturation / 100 * parent.width - 8px; y: (100 - root.picker-value) / 100 * parent.height - 8px; width: 16px; height: 16px; border-radius: 8px; border-width: 2px; border-color: white; background: transparent; }
                TouchArea { moved => { if self.pressed { root.request-picker-color(self.mouse-x / 1px, self.mouse-y / 1px); } } clicked => { root.request-picker-color(self.mouse-x / 1px, self.mouse-y / 1px); root.request-color-confirm(); } }
            }
            Rectangle { x: 18px; y: 252px; width: 378px; height: 10px; border-radius: 5px; background: @linear-gradient(90deg, #ff0000, #ffff00, #00ff00, #00ffff, #0000ff, #ff00ff, #ff0000); Rectangle { x: root.picker-hue / 360 * parent.width - 9px; y: -4px; width: 18px; height: 18px; border-radius: 9px; border-width: 2px; border-color: white; background: AppPalette.primary; } TouchArea { moved => { if self.pressed { root.request-picker-hue(self.mouse-x / 1px); } } clicked => { root.request-picker-hue(self.mouse-x / 1px); } } }
            Text { x: 18px; y: 280px; text: root.picker-color-value; color: AppPalette.text; font-size: 13px; }
            Text { x: 270px; y: 274px; width: 52px; height: 32px; text: "Cancel"; color: AppPalette.text; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; TouchArea { clicked => { root.request-color-cancel(); } } }
            Rectangle { x: 328px; y: 274px; width: 68px; height: 32px; border-radius: 5px; background: AppPalette.primary; Text { width: parent.width; height: parent.height; text: "OK"; color: white; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; TouchArea { clicked => { root.request-color-confirm(); } } } }
            Text { x: 358px; y: 10px; width: 30px; height: 30px; text: "×"; color: AppPalette.secondary; font-size: 22px; horizontal-alignment: center; TouchArea { clicked => { root.color-picker-open = false; } } }
        }
        // Windows frameless windows need explicit client-area resize targets.
        // Keep these above header dragging and below the deletion modal.
        if root.vertical-resize-handles : TouchArea {
            x: root.corner-radius * 1px; y: 0px;
            width: parent.width - 2 * root.corner-radius * 1px; height: 6px;
            mouse-cursor: ns-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.request-vertical-resize(true);
                }
            }
        }
        if root.vertical-resize-handles : TouchArea {
            x: root.corner-radius * 1px; y: parent.height - self.height;
            width: parent.width - 2 * root.corner-radius * 1px; height: 6px;
            mouse-cursor: ns-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.request-vertical-resize(false);
                }
            }
        }
        if root.remove-confirmation-open : Rectangle {
            width: parent.width; height: parent.height; background: #00000088;
            TouchArea { clicked => { root.request-cancel-remove(); } }
            Rectangle {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 462px; height: 190px; border-radius: root.corner-radius * 1px; border-width: 1px; border-color: AppPalette.border; background: AppPalette.card;
                TouchArea {}
                Text { x: 22px; y: 20px; text: "Remove clock?"; color: AppPalette.heading; font-family: "Carlito"; font-size: 17px; font-weight: 700; }
                Text { x: 22px; y: 57px; width: parent.width - 44px; height: 40px; text: "Remove " + root.remove-confirmation-label + " from the clock list?"; color: AppPalette.text; font-family: "Carlito"; font-size: 13px; wrap: word-wrap; }
                Text { x: 22px; y: 108px; text: "This action cannot be undone."; color: AppPalette.muted; font-family: "Carlito"; font-size: 12px; }
                Text { x: parent.width - 178px; y: 138px; width: 70px; height: 34px; text: "Cancel"; color: AppPalette.text; font-family: "Carlito"; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; TouchArea { clicked => { root.request-cancel-remove(); } } }
                Rectangle { x: parent.width - 100px; y: 136px; width: 78px; height: 36px; border-radius: 5px; background: AppPalette.danger-fill; Text { width: parent.width; height: parent.height; text: "Remove"; color: white; font-family: "Carlito"; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; TouchArea { clicked => { root.request-confirm-remove(); } } } }
            }
        }
    }
}
import { ComboBox, LineEdit, ScrollView, Slider } from "std-widgets.slint";
