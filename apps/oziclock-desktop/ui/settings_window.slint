export struct ClockListItem {
    label: string,
    time-zone: string,
    accent: color,
    is-main: bool,
}

export component SettingsWindow inherits Window {
    title: "OziClock — Settings";
    no-frame: true;
    preferred-width: 760px;
    preferred-height: root.clocks.length > 8 ? root.clocks.length * 43px + 166px : 510px;
    min-width: 760px;
    min-height: 510px;
    resize-border-width: 6px;
    background: #17181c;

    in property <[ClockListItem]> clocks;
    in-out property <int> selected-index: -1;
    in-out property <string> editor-label;
    in-out property <string> editor-time-zone;
    in-out property <string> editor-color;
    in-out property <bool> editor-is-main;
    in-out property <string> status-message;
    in-out property <bool> color-picker-open: false;
    in-out property <float> picker-hue: 220;
    in-out property <float> picker-saturation: 70;
    in-out property <float> picker-value: 90;
    in-out property <color> picker-hue-color: #3c81f6;
    in-out property <int> dragging-index: -1;
    callback request-close();
    callback request-window-drag();
    callback request-select(int);
    callback request-add();
    callback request-remove();
    callback request-save();
    callback request-move-up();
    callback request-move-down();
    callback request-drag-clock(int, float);
    callback request-drag-start(int);
    callback request-drag-end();
    callback request-open-color-picker();
    callback request-pick-color(string);
    callback request-picker-color(float, float);
    callback request-picker-hue(float);

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #17181c;
        border-width: 1px;
        border-color: #303238;

        Text { x: 28px; y: 22px; text: "OZI CLOCK"; color: #f2f3f5; font-family: "Calibry"; font-size: 18px; font-weight: 700; }
        Text { x: 28px; y: 49px; text: "Clock settings"; color: #90949d; font-family: "Calibry"; font-size: 13px; }
        TouchArea { x: 0px; y: 0px; width: 690px; height: 82px; pointer-event(event) => { if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) { root.request-window-drag(); } } }
        Rectangle { x: 0px; y: 82px; width: 260px; height: parent.height - 82px; background: #202126; }
        Text { x: 28px; y: 101px; text: "CLOCKS"; color: #8f949e; font-family: "Calibry"; font-size: 11px; font-weight: 700; }

        for clock[index] in root.clocks: Rectangle {
            x: 14px;
            y: 122px + index * 43px;
            animate y { duration: 150ms; easing: ease-in-out; }
            width: 232px;
            height: 37px;
            border-radius: 6px;
            background: index == root.selected-index ? #31343c : #202126;
            Rectangle { x: 10px; y: 10px; width: 17px; height: 17px; border-radius: 5px; background: clock.accent; }
            Text { x: 37px; y: 6px; width: 45px; text: clock.label; color: clock.is-main ? #ffffff : #d7d9de; font-family: "Calibry"; font-size: 14px; font-weight: clock.is-main ? 700 : 500; }
            Text { x: 84px; y: 9px; width: 130px; text: clock.time-zone; color: #8f949e; font-family: "Calibry"; font-size: 11px; overflow: elide; }
            TouchArea { clicked => { root.request-select(index); } }
            Text { x: 216px; y: 7px; width: 12px; text: "⠿"; color: #717783; font-size: 16px; TouchArea { pointer-event(event) => { if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) { root.request-drag-start(index); } } } }
        }
        TouchArea {
            x: 0px; y: 120px; width: 260px; height: parent.height - 120px;
            enabled: root.dragging-index >= 0;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) { root.request-drag-end(); }
            }
            moved => { root.request-drag-clock(root.dragging-index, self.mouse-y / 1px); }
        }

        Rectangle { x: 286px; y: 112px; width: 446px; height: 1px; background: #33353c; }
        Text { x: 286px; y: 137px; text: "Edit clock"; color: #f2f3f5; font-family: "Calibry"; font-size: 21px; font-weight: 700; }
        Text { x: 286px; y: 169px; text: root.status-message; color: #969aa4; font-family: "Calibry"; font-size: 13px; }
        Text { x: 286px; y: 215px; text: "Name"; color: #afb3bc; font-family: "Calibry"; font-size: 12px; font-weight: 600; }

        Rectangle {
            x: 286px; y: 237px; width: 300px; height: 42px; border-radius: 6px; background: transparent;
            LineEdit { x: 8px; y: 5px; width: parent.width - 16px; height: parent.height - 10px; text <=> root.editor-label; }
        }
        Text { x: 286px; y: 305px; text: "Time zone"; color: #afb3bc; font-family: "Calibry"; font-size: 12px; font-weight: 600; }
        Rectangle {
            x: 286px; y: 327px; width: 390px; height: 42px; border-radius: 6px; background: transparent;
            LineEdit { x: 8px; y: 5px; width: parent.width - 16px; height: parent.height - 10px; text <=> root.editor-time-zone; }
        }
        Text { x: 606px; y: 215px; text: "Color"; color: #afb3bc; font-family: "Calibry"; font-size: 12px; font-weight: 600; }
        Rectangle { x: 606px; y: 237px; width: 126px; height: 42px; border-radius: 6px; background: transparent; LineEdit { x: 6px; y: 5px; width: parent.width - 12px; height: parent.height - 10px; text <=> root.editor-color; } }
        Text { x: 606px; y: 286px; width: 126px; height: 24px; text: "Pick color…"; color: #9cc3ff; font-family: "Calibry"; font-size: 13px; vertical-alignment: center; TouchArea { clicked => { root.request-open-color-picker(); } } }
        Rectangle {
            x: 278px; y: 120px; width: 462px; height: 330px; visible: root.color-picker-open; border-radius: 8px; border-width: 1px; border-color: #4a4e58; background: #25272d;
            Text { x: 18px; y: 14px; text: "Choose color"; color: #f0f1f3; font-size: 16px; font-weight: 700; }
            Rectangle { x: 18px; y: 50px; width: 426px; height: 180px; background: root.picker-hue-color;
                Rectangle { width: parent.width; height: parent.height; background: @linear-gradient(90deg, #ffffffff, #ffffff00); }
                Rectangle { width: parent.width; height: parent.height; background: @linear-gradient(180deg, #00000000, #000000ff); }
                Rectangle { x: root.picker-saturation / 100 * parent.width - 8px; y: (100 - root.picker-value) / 100 * parent.height - 8px; width: 16px; height: 16px; border-radius: 8px; border-width: 2px; border-color: white; background: transparent; }
                TouchArea { moved => { root.request-picker-color(self.mouse-x / 1px, self.mouse-y / 1px); } clicked => { root.request-picker-color(self.mouse-x / 1px, self.mouse-y / 1px); } }
            }
            Rectangle { x: 18px; y: 252px; width: 426px; height: 10px; border-radius: 5px; background: @linear-gradient(90deg, #ff0000, #ffff00, #00ff00, #00ffff, #0000ff, #ff00ff, #ff0000); Rectangle { x: root.picker-hue / 360 * parent.width - 9px; y: -4px; width: 18px; height: 18px; border-radius: 9px; border-width: 2px; border-color: white; background: #3c81f6; } TouchArea { moved => { root.request-picker-hue(self.mouse-x / 1px); } clicked => { root.request-picker-hue(self.mouse-x / 1px); } } }
            Text { x: 18px; y: 280px; text: root.editor-color; color: #dce0e7; font-size: 13px; }
            Text { x: 406px; y: 10px; width: 30px; height: 30px; text: "×"; color: #aeb3bd; font-size: 22px; horizontal-alignment: center; TouchArea { clicked => { root.color-picker-open = false; } } }
        }
        Rectangle { x: 286px; y: 382px; width: 22px; height: 22px; border-radius: 5px; background: root.editor-is-main ? #3c81f6 : #24262c; Text { width: parent.width; height: parent.height; text: root.editor-is-main ? "✓" : ""; color: white; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.editor-is-main = !root.editor-is-main; } } }
        Text { x: 318px; y: 384px; text: "Primary clock"; color: #d9dce1; font-family: "Calibry"; font-size: 13px; }
        Rectangle {
            x: parent.width - 130px; y: parent.height - 58px; width: 102px; height: 42px; border-radius: 6px; background: #3c81f6;
            Text { width: parent.width; height: parent.height; text: "Save"; color: #ffffff; font-family: "Calibry"; font-size: 14px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; TouchArea { clicked => { root.request-save(); } } }
        }
        Text { x: parent.width - 300px; y: parent.height - 58px; width: 70px; height: 42px; text: "+ Add"; color: #9cc3ff; font-family: "Calibry"; font-size: 13px; vertical-alignment: center; TouchArea { clicked => { root.request-add(); } } }
        Text { x: parent.width - 215px; y: parent.height - 58px; width: 78px; height: 42px; text: "Remove"; color: #f09090; font-family: "Calibry"; font-size: 13px; vertical-alignment: center; TouchArea { clicked => { root.request-remove(); } } }
        Text {
            x: 702px; y: 22px; width: 30px; height: 30px; text: "×"; color: #aeb3bd; font-family: "Calibry"; font-size: 24px; horizontal-alignment: center; vertical-alignment: center;
            TouchArea { clicked => { root.request-close(); } }
        }
    }
}
import { LineEdit } from "std-widgets.slint";
