import { ClockTile } from "../../../ui/clock_tile.slint";

export struct ClockListItem {
    label: string,
    time-zone: string,
    accent: color,
    is-main: bool,
}

export component SettingsWindow inherits Window {
    title: "OziClock — Settings";
    no-frame: true;
    always-on-top: true;
    preferred-width: root.saved-window-width * 1px;
    preferred-height: root.saved-window-height * 1px;
    min-width: 760px;
    min-height: 700px;
    resize-border-width: 6px;
    background: transparent;

    in property <[ClockListItem]> clocks;
    in property <[string]> time-zones;
    in property <[string]> time-zone-ids;
    in-out property <int> selected-index: -1;
    in-out property <int> selected-section: 0;
    in-out property <string> editor-label;
    in-out property <string> editor-time-zone;
    in-out property <int> selected-time-zone-index: -1;
    in-out property <string> time-zone-search;
    in-out property <string> time-zone-search-message;
    out property <bool> time-zone-search-focused: time-zone-search-input.has-focus;
    out property <bool> time-zone-picker-focused: time-zone-picker.has-focus;
    in-out property <string> editor-color;
    in-out property <bool> editor-is-main;
    in-out property <bool> show-seconds;
    in-out property <bool> top-most;
    in-out property <bool> show-in-task-bar;
    in-out property <bool> launch-at-login;
    in-out property <float> opacity-percent;
    in-out property <bool> compact-mode;
    in-out property <float> clock-scale-percent: 100;
    in-out property <float> corner-radius: 12;
    in-out property <bool> soft-clock-style: false;
    in-out property <string> border-color-value: "#000000";
    in-out property <color> border-preview-color: #000000;
    in-out property <float> non-main-dimming: 0;
    in-out property <bool> calendar-light-theme: true;
    in-out property <bool> calendar-monday-first: true;
    in-out property <int> calendar-hour-range: 0;
    in-out property <string> status-message;
    in-out property <bool> color-picker-open: false;
    in-out property <bool> picking-border-color: false;
    in-out property <float> picker-hue: 220;
    in-out property <float> picker-saturation: 70;
    in-out property <float> picker-value: 90;
    in-out property <color> picker-hue-color: #3c81f6;
    in-out property <color> editor-preview-color: #ffffff;
    in-out property <int> dragging-index: -1;
    in-out property <float> dragging-offset: 0;
    in-out property <bool> remove-confirmation-open: false;
    in-out property <string> remove-confirmation-label;
    in-out property <float> saved-window-width: 760;
    in-out property <float> saved-window-height: 700;
    callback request-close();
    callback request-window-drag();
    callback request-select(int);
    callback request-select-general();
    callback request-select-calendar();
    callback request-add();
    callback request-remove(int);
    callback request-confirm-remove();
    callback request-cancel-remove();
    callback request-save();
    callback request-apply();
    callback request-move-up();
    callback request-move-down();
    callback request-drag-clock(int, float);
    callback request-list-press(float, float);
    callback request-drag-end();
    callback request-open-color-picker();
    callback request-open-border-color-picker();
    callback request-pick-color(string);
    callback request-picker-color(float, float);
    callback request-picker-hue(float);
    callback request-select-time-zone(int);
    callback request-filter-time-zones(string);
    callback request-color-confirm();
    callback request-color-cancel();
    callback request-set-show-seconds(bool);
    callback request-set-top-most(bool);
    callback request-set-show-in-task-bar(bool);
    callback request-set-launch-at-login(bool);
    callback request-set-opacity(float);
    callback request-set-compact-mode(bool);
    callback request-set-clock-scale(float);
    callback request-set-corner-radius(float);
    callback request-set-soft-clock-style(bool);
    callback request-set-border-color(string);
    callback request-set-non-main-dimming(float);
    callback request-set-calendar-light-theme(bool);
    callback request-set-calendar-monday-first(bool);
    callback request-set-calendar-hour-range(int);

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #17181c;
        border-radius: root.corner-radius * 1px;
        clip: true;
        border-width: 1px;
        border-color: #303238;

        Text { x: 28px; y: 22px; text: "OZI CLOCK"; color: #f2f3f5; font-family: "Carlito"; font-size: 18px; font-weight: 700; }
        Text { x: 28px; y: 49px; text: "Clock settings"; color: #90949d; font-family: "Carlito"; font-size: 13px; }
        TouchArea { x: 0px; y: 0px; width: 690px; height: 82px; pointer-event(event) => { if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) { root.request-window-drag(); } } }
        ClockTile { x: parent.width - 127px; y: 94px; visible: root.selected-section == 1; label: root.editor-label; month: "08/"; day: "24"; hour: "12"; minute: "34"; second: "56"; accent: root.editor-preview-color; main-zone: root.editor-is-main; soft-style: root.soft-clock-style; }
        Rectangle { x: 0px; y: 82px; width: 260px; height: parent.height - 82px; background: #202126; }
        Rectangle { x: 14px; y: 120px; width: 232px; height: 37px; border-radius: 6px; background: root.selected-section == 0 ? #31343c : #202126; Text { x: 10px; y: 9px; text: "General"; color: #d7d9de; font-family: "Carlito"; font-size: 14px; } TouchArea { clicked => { root.request-select-general(); } } }
        Rectangle { x: 14px; y: 163px; width: 232px; height: 37px; border-radius: 6px; background: root.selected-section == 2 ? #31343c : #202126; Text { x: 10px; y: 9px; text: "Calendar"; color: #d7d9de; font-family: "Carlito"; font-size: 14px; } TouchArea { clicked => { root.request-select-calendar(); } } }
        Text { x: 28px; y: 217px; text: "CLOCKS"; color: #8f949e; font-family: "Carlito"; font-size: 11px; font-weight: 700; }

        Rectangle {
            x: 14px;
            y: 238px;
            width: 232px;
            height: 37px;
            border-radius: 6px;
            background: #202126;
            Text { x: 10px; y: 8px; text: "+ Add clock"; color: #9cc3ff; font-family: "Carlito"; font-size: 14px; }
            TouchArea { clicked => { root.request-add(); } }
        }
        clock-list-scroll := ScrollView {
            x: 0px;
            y: 283px;
            width: 260px;
            height: parent.height - 283px;
            viewport-width: 260px;
            viewport-height: root.clocks.length * 43px;
            vertical-scrollbar-policy: ScrollBarPolicy.always-on;
        for clock[index] in root.clocks: Rectangle {
            x: 14px;
            y: index * 43px + (index == root.dragging-index ? root.dragging-offset * 1px : 0px);
            animate y { duration: index == root.dragging-index ? 0ms : 80ms; easing: ease-in-out; }
            width: 232px;
            height: 37px;
            border-radius: 6px;
            background: root.selected-section == 1 && index == root.selected-index ? #31343c : #202126;
            Text { x: 10px; y: 10px; width: 12px; height: 17px; text: "⠿"; color: #717783; font-size: 16px; vertical-alignment: center; }
            Rectangle { x: 30px; y: 9px; width: 18px; height: 18px; border-radius: 5px; background: clock.accent; }
            Text { x: 57px; y: 8px; width: 45px; height: 21px; text: clock.label; color: clock.is-main ? #ffffff : #d7d9de; font-family: "Carlito"; font-size: 14px; font-weight: clock.is-main ? 700 : 500; vertical-alignment: center; }
            Text { x: 104px; y: 8px; width: 100px; height: 21px; text: clock.time-zone; color: #8f949e; font-family: "Carlito"; font-size: 11px; overflow: elide; vertical-alignment: center; }
            Rectangle { x: 214px; y: 9px; width: 14px; height: 2px; border-radius: 1px; background: #e06a6a; }
            Rectangle { x: 218px; y: 7px; width: 6px; height: 2px; border-radius: 1px; background: #e06a6a; }
            Rectangle { x: 216px; y: 12px; width: 10px; height: 13px; border-radius: 1px; border-width: 1px; border-color: #e06a6a; background: transparent;
                Rectangle { x: 2px; y: 2px; width: 1px; height: 7px; background: #e06a6a; }
                Rectangle { x: 5px; y: 2px; width: 1px; height: 7px; background: #e06a6a; }
            }
        }
        TouchArea {
            x: 0px; y: 0px; width: 260px; height: root.clocks.length * 43px;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) { root.request-list-press(self.mouse-x / 1px, self.mouse-y / 1px); }
                if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) { root.request-drag-end(); }
            }
            moved => { root.request-drag-clock(root.dragging-index, self.mouse-y / 1px); }
        }
        }
        Rectangle {
            x: 14px;
            y: 283px + root.dragging-index * 43px - clock-list-scroll.viewport-y + root.dragging-offset * 1px;
            width: 232px;
            height: 37px;
            visible: root.dragging-index >= 0 && root.dragging-index < root.clocks.length;
            border-radius: 6px;
            background: #31343c;
            Text { x: 10px; y: 10px; width: 12px; height: 17px; text: "⠿"; color: #717783; font-size: 16px; vertical-alignment: center; }
            Rectangle { x: 30px; y: 9px; width: 18px; height: 18px; border-radius: 5px; background: root.clocks[root.dragging-index].accent; }
            Text { x: 57px; y: 8px; width: 45px; height: 21px; text: root.clocks[root.dragging-index].label; color: #ffffff; font-family: "Carlito"; font-size: 14px; font-weight: 700; vertical-alignment: center; }
            Text { x: 104px; y: 8px; width: 100px; height: 21px; text: root.clocks[root.dragging-index].time-zone; color: #8f949e; font-family: "Carlito"; font-size: 11px; overflow: elide; vertical-alignment: center; }
            Rectangle { x: 214px; y: 9px; width: 14px; height: 2px; border-radius: 1px; background: #e06a6a; }
            Rectangle { x: 218px; y: 7px; width: 6px; height: 2px; border-radius: 1px; background: #e06a6a; }
            Rectangle { x: 216px; y: 12px; width: 10px; height: 13px; border-radius: 1px; border-width: 1px; border-color: #e06a6a; background: transparent; }
        }

        Rectangle { x: 286px; y: 82px; width: 446px; height: 1px; background: #33353c; }
        Text { x: 286px; y: 107px; text: root.selected-section == 0 ? "General" : (root.selected-section == 2 ? "Calendar" : "Edit clock"); color: #f2f3f5; font-family: "Carlito"; font-size: 21px; font-weight: 700; }
        Text { x: 286px; y: 139px; visible: root.selected-section == 1; text: root.status-message; color: #969aa4; font-family: "Carlito"; font-size: 13px; }
        Text { x: 286px; y: 145px; visible: root.selected-section == 0; text: "Application behavior"; color: #969aa4; font-family: "Carlito"; font-size: 13px; }
        Text { x: 286px; y: 185px; visible: root.selected-section == 1; text: "Name"; color: #afb3bc; font-family: "Carlito"; font-size: 12px; font-weight: 600; }

        Rectangle {
            x: 286px; y: 207px; visible: root.selected-section == 1; width: 300px; height: 42px; border-radius: 6px; background: transparent;
            LineEdit { x: 0px; y: 0px; width: parent.width; height: parent.height; text <=> root.editor-label; edited => { root.request-apply(); } }
        }
        Text { x: 286px; y: 275px; visible: root.selected-section == 1; text: "Time zone"; color: #afb3bc; font-family: "Carlito"; font-size: 12px; font-weight: 600; }
        Rectangle {
            x: 286px; y: 297px; visible: root.selected-section == 1; width: 390px; height: 42px; border-radius: 6px; background: transparent;
            time-zone-search-input := LineEdit {
                width: parent.width; height: parent.height;
                placeholder-text: "Search by city, region, or UTC offset";
                text <=> root.time-zone-search;
                edited(value) => { root.request-filter-time-zones(value); }
            }
        }
        time-zone-picker := ComboBox { x: 286px; y: 347px; visible: root.selected-section == 1; width: 390px; height: 42px; model: root.time-zones; current-index <=> root.selected-time-zone-index; selected => { root.request-select-time-zone(self.current-index); } }
        Text { x: 286px; y: 393px; visible: root.selected-section == 1 && root.time-zone-search-message != ""; text: root.time-zone-search-message; color: #969aa4; font-family: "Carlito"; font-size: 13px; }
        Text { x: 606px; y: 185px; visible: root.selected-section == 1; text: "Color"; color: #afb3bc; font-family: "Carlito"; font-size: 12px; font-weight: 600; }
        Rectangle { x: 606px; y: 207px; visible: root.selected-section == 1; width: 126px; height: 42px; border-radius: 6px; background: transparent; LineEdit { x: 0px; y: 0px; width: parent.width; height: parent.height; text <=> root.editor-color; edited => { root.request-apply(); } } }
        Text { x: 606px; y: 256px; visible: root.selected-section == 1; width: 126px; height: 24px; text: "Pick color…"; color: #9cc3ff; font-family: "Carlito"; font-size: 13px; vertical-alignment: center; TouchArea { clicked => { root.request-open-color-picker(); } } }
        Rectangle { x: 286px; y: 432px; width: 22px; height: 22px; visible: root.selected-section == 1 && !root.color-picker-open; border-radius: 5px; background: root.editor-is-main ? #3c81f6 : #24262c; Text { width: parent.width; height: parent.height; text: root.editor-is-main ? "✓" : ""; color: white; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.editor-is-main = !root.editor-is-main; root.request-apply(); } } }
        Text { x: 318px; y: 434px; visible: root.selected-section == 1 && !root.color-picker-open; text: "Primary clock"; color: #d9dce1; font-family: "Carlito"; font-size: 13px; }
        Rectangle { x: 286px; y: 184px; width: 22px; height: 22px; visible: root.selected-section == 0; border-radius: 5px; background: root.top-most ? #3c81f6 : #24262c; Text { width: parent.width; height: parent.height; text: root.top-most ? "✓" : ""; color: white; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.top-most = !root.top-most; root.request-set-top-most(root.top-most); } } }
        Text { x: 318px; y: 186px; visible: root.selected-section == 0; text: "Always on top"; color: #d9dce1; font-family: "Carlito"; font-size: 13px; }
        Rectangle { x: 286px; y: 218px; width: 22px; height: 22px; visible: root.selected-section == 0; border-radius: 5px; background: root.show-seconds ? #3c81f6 : #24262c; Text { width: parent.width; height: parent.height; text: root.show-seconds ? "✓" : ""; color: white; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.show-seconds = !root.show-seconds; root.request-set-show-seconds(root.show-seconds); } } }
        Text { x: 318px; y: 220px; visible: root.selected-section == 0; text: "Show seconds"; color: #d9dce1; font-family: "Carlito"; font-size: 13px; }
        Rectangle { x: 286px; y: 252px; width: 22px; height: 22px; visible: root.selected-section == 0; border-radius: 5px; background: root.compact-mode ? #3c81f6 : #24262c; Text { width: parent.width; height: parent.height; text: root.compact-mode ? "✓" : ""; color: white; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.compact-mode = !root.compact-mode; root.request-set-compact-mode(root.compact-mode); } } }
        Text { x: 318px; y: 254px; visible: root.selected-section == 0; text: "Compact mode"; color: #d9dce1; font-family: "Carlito"; font-size: 13px; }
        Rectangle { x: 286px; y: 286px; width: 22px; height: 22px; visible: root.selected-section == 0; border-radius: 5px; background: root.show-in-task-bar ? #3c81f6 : #24262c; Text { width: parent.width; height: parent.height; text: root.show-in-task-bar ? "✓" : ""; color: white; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.show-in-task-bar = !root.show-in-task-bar; root.request-set-show-in-task-bar(root.show-in-task-bar); } } }
        Text { x: 318px; y: 288px; visible: root.selected-section == 0; text: "Show in taskbar"; color: #d9dce1; font-family: "Carlito"; font-size: 13px; }
        Rectangle { x: 510px; y: 184px; width: 22px; height: 22px; visible: root.selected-section == 0; border-radius: 5px; background: root.soft-clock-style ? #3c81f6 : #24262c; Text { width: parent.width; height: parent.height; text: root.soft-clock-style ? "✓" : ""; color: white; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.soft-clock-style = !root.soft-clock-style; root.request-set-soft-clock-style(root.soft-clock-style); } } }
        Text { x: 542px; y: 186px; visible: root.selected-section == 0; text: "Soft color style"; color: #d9dce1; font-family: "Carlito"; font-size: 13px; }
        Rectangle { x: 510px; y: 218px; width: 22px; height: 22px; visible: root.selected-section == 0; border-radius: 5px; background: root.launch-at-login ? #3c81f6 : #24262c; Text { width: parent.width; height: parent.height; text: root.launch-at-login ? "✓" : ""; color: white; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.launch-at-login = !root.launch-at-login; root.request-set-launch-at-login(root.launch-at-login); } } }
        Text { x: 542px; y: 220px; visible: root.selected-section == 0; text: "Launch at login"; color: #d9dce1; font-family: "Carlito"; font-size: 13px; }
        Text { x: 286px; y: 332px; visible: root.selected-section == 0; text: "Opacity"; color: #afb3bc; font-family: "Carlito"; font-size: 12px; font-weight: 600; }
        Slider { x: 286px; y: 352px; width: 310px; height: 24px; visible: root.selected-section == 0; minimum: 2; maximum: 100; step: 1; value <=> root.opacity-percent; changed => { root.request-set-opacity(self.value); } }
        Text { x: 612px; y: 351px; width: 64px; height: 24px; visible: root.selected-section == 0; text: Math.round(root.opacity-percent) + "%"; color: #d9dce1; font-family: "Carlito"; font-size: 13px; horizontal-alignment: right; vertical-alignment: center; }
        Text { x: 286px; y: 386px; visible: root.selected-section == 0; text: "Clock scale"; color: #afb3bc; font-family: "Carlito"; font-size: 12px; font-weight: 600; }
        Slider { x: 286px; y: 406px; width: 310px; height: 24px; visible: root.selected-section == 0; minimum: 80; maximum: 150; step: 5; value <=> root.clock-scale-percent; changed => { root.request-set-clock-scale(self.value); } }
        Text { x: 612px; y: 405px; width: 64px; height: 24px; visible: root.selected-section == 0; text: Math.round(root.clock-scale-percent) + "%"; color: #d9dce1; font-family: "Carlito"; font-size: 13px; horizontal-alignment: right; vertical-alignment: center; }
        Text { x: 286px; y: 440px; visible: root.selected-section == 0; text: "Corner radius"; color: #afb3bc; font-family: "Carlito"; font-size: 12px; font-weight: 600; }
        Slider { x: 286px; y: 460px; width: 310px; height: 24px; visible: root.selected-section == 0; minimum: 0; maximum: 15.5; step: 0.5; value <=> root.corner-radius; changed => { root.request-set-corner-radius(self.value); } }
        Text { x: 612px; y: 459px; width: 64px; height: 24px; visible: root.selected-section == 0; text: Math.round(root.corner-radius) + " px"; color: #d9dce1; font-family: "Carlito"; font-size: 13px; horizontal-alignment: right; vertical-alignment: center; }
        Text { x: 286px; y: 494px; visible: root.selected-section == 0; text: "Border and separator color"; color: #afb3bc; font-family: "Carlito"; font-size: 12px; font-weight: 600; }
        Rectangle { x: 286px; y: 514px; visible: root.selected-section == 0; width: 190px; height: 38px; border-radius: 6px; background: transparent; LineEdit { width: parent.width; height: parent.height; text <=> root.border-color-value; edited => { root.request-set-border-color(root.border-color-value); } } }
        Rectangle { x: 488px; y: 521px; visible: root.selected-section == 0; width: 24px; height: 24px; border-radius: 5px; border-width: 1px; border-color: #70747d; background: root.border-preview-color; TouchArea { clicked => { root.request-open-border-color-picker(); } } }
        Text { x: 286px; y: 568px; visible: root.selected-section == 0; text: "Dim non-primary clocks"; color: #afb3bc; font-family: "Carlito"; font-size: 12px; font-weight: 600; }
        Slider { x: 286px; y: 588px; width: 310px; height: 24px; visible: root.selected-section == 0; minimum: 0; maximum: 80; step: 5; value <=> root.non-main-dimming; changed => { root.request-set-non-main-dimming(self.value); } }
        Text { x: 612px; y: 587px; width: 64px; height: 24px; visible: root.selected-section == 0; text: Math.round(root.non-main-dimming) + "%"; color: #d9dce1; font-family: "Carlito"; font-size: 13px; horizontal-alignment: right; vertical-alignment: center; }
        Text { x: 286px; y: 145px; visible: root.selected-section == 2; text: "Calendar appearance and week layout"; color: #969aa4; font-family: "Carlito"; font-size: 13px; }
        Text { x: 286px; y: 192px; visible: root.selected-section == 2; text: "Theme"; color: #afb3bc; font-family: "Carlito"; font-size: 12px; font-weight: 600; }
        ComboBox { x: 286px; y: 214px; visible: root.selected-section == 2; width: 240px; height: 40px; model: ["Light", "Dark"]; current-index: root.calendar-light-theme ? 0 : 1; selected => { root.calendar-light-theme = self.current-index == 0; root.request-set-calendar-light-theme(root.calendar-light-theme); } }
        Text { x: 286px; y: 278px; visible: root.selected-section == 2; text: "First day of week"; color: #afb3bc; font-family: "Carlito"; font-size: 12px; font-weight: 600; }
        ComboBox { x: 286px; y: 300px; visible: root.selected-section == 2; width: 240px; height: 40px; model: ["Monday", "Sunday"]; current-index: root.calendar-monday-first ? 0 : 1; selected => { root.calendar-monday-first = self.current-index == 0; root.request-set-calendar-monday-first(root.calendar-monday-first); } }
        Text { x: 286px; y: 364px; visible: root.selected-section == 2; text: "Week view"; color: #afb3bc; font-family: "Carlito"; font-size: 12px; font-weight: 600; }
        Text { x: 286px; y: 386px; visible: root.selected-section == 2; text: "Fixed 12-hour viewport · continuous day-by-day scrolling"; color: #d9dce1; font-family: "Carlito"; font-size: 13px; }
        Rectangle {
            x: parent.width - 130px; y: parent.height - 58px; width: 102px; height: 42px; border-radius: 6px; background: #3c81f6;
            Text { width: parent.width; height: parent.height; text: "OK"; color: #ffffff; font-family: "Carlito"; font-size: 14px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; TouchArea { clicked => { root.request-save(); } } }
        }
        Text {
            x: 702px; y: 22px; width: 30px; height: 30px; text: "×"; color: #aeb3bd; font-family: "Carlito"; font-size: 24px; horizontal-alignment: center; vertical-alignment: center;
            TouchArea { clicked => { root.request-close(); } }
        }
        Rectangle {
            x: 278px; y: 165px; width: 462px; height: 330px; visible: root.color-picker-open; border-radius: root.corner-radius * 1px; border-width: 1px; border-color: #4a4e58; background: #25272d;
            Text { x: 18px; y: 14px; text: "Choose color"; color: #f0f1f3; font-size: 16px; font-weight: 700; }
            Rectangle { x: 18px; y: 50px; width: 426px; height: 180px; background: root.picker-hue-color;
                Rectangle { width: parent.width; height: parent.height; background: @linear-gradient(90deg, #ffffffff, #ffffff00); }
                Rectangle { width: parent.width; height: parent.height; background: @linear-gradient(180deg, #00000000, #000000ff); }
                Rectangle { x: root.picker-saturation / 100 * parent.width - 8px; y: (100 - root.picker-value) / 100 * parent.height - 8px; width: 16px; height: 16px; border-radius: 8px; border-width: 2px; border-color: white; background: transparent; }
                TouchArea { moved => { root.request-picker-color(self.mouse-x / 1px, self.mouse-y / 1px); } clicked => { root.request-picker-color(self.mouse-x / 1px, self.mouse-y / 1px); } }
            }
            Rectangle { x: 18px; y: 252px; width: 426px; height: 10px; border-radius: 5px; background: @linear-gradient(90deg, #ff0000, #ffff00, #00ff00, #00ffff, #0000ff, #ff00ff, #ff0000); Rectangle { x: root.picker-hue / 360 * parent.width - 9px; y: -4px; width: 18px; height: 18px; border-radius: 9px; border-width: 2px; border-color: white; background: #3c81f6; } TouchArea { moved => { root.request-picker-hue(self.mouse-x / 1px); } clicked => { root.request-picker-hue(self.mouse-x / 1px); } } }
            Text { x: 18px; y: 280px; text: root.picking-border-color ? root.border-color-value : root.editor-color; color: #dce0e7; font-size: 13px; }
            Text { x: 318px; y: 274px; width: 52px; height: 32px; text: "Cancel"; color: #c7ccd5; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; TouchArea { clicked => { root.request-color-cancel(); } } }
            Rectangle { x: 376px; y: 274px; width: 68px; height: 32px; border-radius: 5px; background: #3c81f6; Text { width: parent.width; height: parent.height; text: "OK"; color: white; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; TouchArea { clicked => { root.request-color-confirm(); } } } }
            Text { x: 406px; y: 10px; width: 30px; height: 30px; text: "×"; color: #aeb3bd; font-size: 22px; horizontal-alignment: center; TouchArea { clicked => { root.color-picker-open = false; } } }
        }
        Rectangle {
            x: 278px; y: 230px; width: 462px; height: 190px; visible: root.remove-confirmation-open; border-radius: root.corner-radius * 1px; border-width: 1px; border-color: #4a4e58; background: #25272d;
            Text { x: 22px; y: 20px; text: "Remove clock?"; color: #f0f1f3; font-family: "Carlito"; font-size: 17px; font-weight: 700; }
            Text { x: 22px; y: 57px; width: 418px; height: 40px; text: "Remove " + root.remove-confirmation-label + " from the clock list?"; color: #c7ccd5; font-family: "Carlito"; font-size: 13px; wrap: word-wrap; }
            Text { x: 22px; y: 108px; text: "This action cannot be undone."; color: #969aa4; font-family: "Carlito"; font-size: 12px; }
            Text { x: 284px; y: 138px; width: 70px; height: 34px; text: "Cancel"; color: #c7ccd5; font-family: "Carlito"; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; TouchArea { clicked => { root.request-cancel-remove(); } } }
            Rectangle { x: 362px; y: 136px; width: 78px; height: 36px; border-radius: 5px; background: #b84b4b; Text { width: parent.width; height: parent.height; text: "Remove"; color: white; font-family: "Carlito"; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; TouchArea { clicked => { root.request-confirm-remove(); } } } }
        }
    }
}
import { ComboBox, LineEdit, ScrollView, Slider } from "std-widgets.slint";
