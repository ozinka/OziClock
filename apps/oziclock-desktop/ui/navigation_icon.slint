import { CalendarIcon } from "calendar_icon.slint";

export enum NavigationIconKind { plan, alarm, timer, stopwatch, reminder, task, settings, rulers, about, exit }

export component NavigationIcon inherits Rectangle {
    in property <NavigationIconKind> kind;
    in property <color> icon-color;
    width: 20px; height: 20px; background: transparent;

    if root.kind == NavigationIconKind.plan: CalendarIcon { x: 0px; y: 0px; icon-color: root.icon-color; }
    if root.kind == NavigationIconKind.alarm: Rectangle { x: 3px; y: 3px; width: 14px; height: 14px; border-radius: 7px; border-width: 1px; border-color: root.icon-color; background: transparent; Rectangle { x: 6px; y: 3px; width: 1px; height: 5px; background: root.icon-color; } Rectangle { x: 6px; y: 7px; width: 4px; height: 1px; background: root.icon-color; } }
    if root.kind == NavigationIconKind.timer || root.kind == NavigationIconKind.stopwatch: Rectangle { x: 2px; y: 3px; width: 16px; height: 16px; border-radius: 8px; border-width: 1px; border-color: root.icon-color; background: transparent; Rectangle { x: 7px; y: -3px; width: 2px; height: 4px; background: root.icon-color; } Rectangle { x: 7px; y: 3px; width: 1px; height: 6px; background: root.icon-color; } Rectangle { x: 7px; y: 8px; width: 5px; height: 1px; background: root.icon-color; } }
    if root.kind == NavigationIconKind.reminder: Rectangle { x: 3px; y: 2px; width: 14px; height: 17px; border-radius: 2px; border-width: 1px; border-color: root.icon-color; background: transparent; Rectangle { x: 4px; y: -2px; width: 6px; height: 4px; border-radius: 2px; background: root.icon-color; } Rectangle { x: 4px; y: 6px; width: 7px; height: 1px; background: root.icon-color; } Rectangle { x: 4px; y: 10px; width: 7px; height: 1px; background: root.icon-color; } }
    if root.kind == NavigationIconKind.task: Rectangle { x: 2px; y: 2px; width: 16px; height: 16px; border-radius: 8px; border-width: 1px; border-color: root.icon-color; background: transparent; Text { width: parent.width; height: parent.height; text: "✓"; color: root.icon-color; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
    if root.kind == NavigationIconKind.settings: Rectangle {
        width: 20px; height: 20px; background: transparent;
        for line[index] in [0, 1, 2]: Rectangle { x: 3px; y: 4px + index * 6px; width: 14px; height: 1px; background: root.icon-color; }
        for position[index] in [6, 13, 8]: Rectangle { x: position * 1px - 1px; y: 2px + index * 6px; width: 3px; height: 5px; border-radius: 1px; background: root.icon-color; }
    }
    if root.kind == NavigationIconKind.rulers: Rectangle {
        x: 3px; y: 2px; width: 14px; height: 17px; border-radius: 2px; border-width: 1px; border-color: root.icon-color; background: transparent;
        for tick[index] in [0, 1, 2, 3]: Rectangle { x: 0px; y: 3px + index * 3px; width: Math.mod(index, 2) == 0 ? 6px : 4px; height: 1px; background: root.icon-color; }
    }
    if root.kind == NavigationIconKind.about: Rectangle {
        x: 2px; y: 2px; width: 16px; height: 16px; border-radius: 8px; border-width: 1px; border-color: root.icon-color; background: transparent;
        Rectangle { x: 7px; y: 4px; width: 2px; height: 2px; border-radius: 1px; background: root.icon-color; }
        Rectangle { x: 7px; y: 8px; width: 2px; height: 5px; border-radius: 1px; background: root.icon-color; }
    }
    if root.kind == NavigationIconKind.exit: Rectangle {
        width: 20px; height: 20px; background: transparent;
        Rectangle { x: 2px; y: 3px; width: 8px; height: 14px; border-radius: 1px; border-width: 1px; border-color: root.icon-color; background: transparent; }
        Path { width: 20px; height: 20px; commands: "M 7 10 L 18 10 M 14 6 L 18 10 L 14 14"; stroke: root.icon-color; stroke-width: 1px; }
    }
}
